/-!
# The exponent filtration of the infinitesimal site

An object `X = (π : B → C)` of the big infinitesimal site `INF(C/A)` has a
kernel with bounded nilpotence exponent (`kernel_bounded`). We say that `X` has
exponent `e` if `x ^ e = 0` for every `x ∈ ker π`, and write `exp(X)` for the
least such `e`. The infinitesimal site of exponent `e` is the full subcategory
`INF^{(e)}` (`Level A C e`) of objects having exponent `e`; these subcategories
increase with `e` and exhaust `INF(C/A)`.

For a prime `p` (more generally an integer `p > 1`), the *Frobenius exponent* of `X`
is the least `e` such that `X` has exponent `p ^ e`, i.e. such that `x ↦ x ^ (p ^ e)`
kills `ker π`. The *Frobenius levels* are the subcategories `INF^{(p ^ e)}`
(`Level A C (p ^ e)`); they also increase and exhaust `INF(C/A)`. In the accompanying
article `INF_e` denotes the Frobenius level `Level A C (p ^ e)`; in this library the
exponent filtration is indexed by an arbitrary exponent `e`, and the Frobenius levels
are the special case of exponents `p ^ e`.

For a surjection `π : B → C` and `e > 0`, the truncation
`T_e(B) = B / (x ^ e : x ∈ ker π)` is an object of `INF^{(e)}`, and every
`A`-algebra map `B → Y` over `C` with `Y` in `INF^{(e)}` factors uniquely through
`B → T_e(B)`. Since the kernels involved need not be finitely generated, we
truncate by the ideal generated by `e`-th powers and not by a power of the
kernel. Using truncations we show, for `e > 0`:

* `INF^{(e)}` has binary coproducts: the coproduct of `B → C` and `B' → C` is the
  truncation of `B ⊗_A B' → C`;
* let `X^{(e)}(n)` be the truncation of `A[x_{i,c} : i ∈ [n], c ∈ C] → C`,
  `x_{i,c} ↦ c`. Morphisms `X^{(e)}(n) → Y` correspond to `(n+1)`-tuples of
  set-theoretic sections of `Y → C`, naturally in `Y` and compatibly with the
  maps `X^{(e)}(m) → X^{(e)}(n)` given by renaming the variables. In particular
  `X^{(e)}(•)` is a cosimplicial object of `INF^{(e)}`, and `X^{(e)}(0)` maps to every
  object.

In the site orientation `INF^{(e)}ᵒᵖ` this says that `INF^{(e)}` has binary products, that
`X^{(e)}(0)` is weakly final and that `X^{(e)}(•)` is its Čech nerve: these are the
hypotheses of [Stacks, Tag 07JM] for computing cohomology by a Čech complex.
The polynomial rings are only a device in proofs: they enter neither the
definition of the site nor that of `ocris`.

## Main definitions

* `powIdeal K e`: the ideal generated by the `e`-th powers of elements of `K`.
* `InfinitesimalThickening.HasExponent`, `InfinitesimalThickening.exponent`:
  exponents and the minimal exponent `exp(X)`.
* `InfinitesimalThickening.frobeniusExponent`: the least `e` such that `X` has
  exponent `p ^ e`.
* `Level A C e`: the site `INF^{(e)}`, with inclusions `Level.ι` and `Level.incl`.
* `InfinitesimalThickening.truncate`, `InfinitesimalThickening.truncateLift`:
  the truncation `T_e(B)` and its universal property.
* `Level.truncation`, `Level.truncationAdjunction`: the truncation functor
  `T_e : INF(C/A) ⥤ INF^{(e)}`, left adjoint to the inclusion.
* `Level.coprod`, `Level.inl`, `Level.inr`, `Level.coprodDesc`: binary
  coproducts in `INF^{(e)}`.
* `InfinitesimalThickening.Sections`: set-theoretic sections of `B → C`.
* `Level.cechObj`, `Level.cechMap`, `Level.cechNerve`: the cosimplicial object
  `X^{(e)}(•)`.

## Main results

* `InfinitesimalThickening.exponent_le_iff`: `X` has exponent `e` if and only
  if `exp(X) ≤ e`.
* `InfinitesimalThickening.frobeniusExponent_le_iff`: `X` has exponent `p ^ e` if and
  only if its Frobenius exponent is at most `e`.
* `Level.exists_level`: every object lies in some `INF^{(e)}`.
* `Level.exponentLE_pow_mono`, `Level.inclPow`, `Level.exists_frobenius_level`: the
  Frobenius levels `INF^{(p ^ e)}` increase with `e` and exhaust `INF(C/A)`.
* `Level.coprodCofanIsColimit`, `Level.hasBinaryCoproducts`: `INF^{(e)}` has binary
  coproducts.
* `Level.cechHomEquiv`, `Level.cechHomEquiv_cechMap`, `Level.cechHomEquiv_comp`:
  morphisms out of `X^{(e)}(n)` are `(n+1)`-tuples of sections.
* `Level.nonempty_hom_cechObj_zero`: `X^{(e)}(0)` maps to every object of `INF^{(e)}`.

## References

* [Stacks Project, Tag 07JM](https://stacks.math.columbia.edu/tag/07JM)
-/

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct

universe u

namespace AffineCrystalline.InfinitesimalSite

/-! ## Ideals generated by `e`-th powers -/

section PowIdeal

variable {R : Type*} [CommRing R]

/-- The ideal generated by the `e`-th powers of the elements of `K`. -/
def powIdeal (K : Ideal R) (e : ℕ) : Ideal R :=
  Ideal.span {y | ∃ x ∈ K, x ^ e = y}

theorem pow_mem_powIdeal {K : Ideal R} {e : ℕ} {x : R} (hx : x ∈ K) :
    x ^ e ∈ powIdeal K e :=
  Ideal.subset_span ⟨x, hx, rfl⟩

/-- For `e > 0`, `powIdeal K e ⊆ K`. -/
theorem powIdeal_le {K : Ideal R} {e : ℕ} (he : 0 < e) : powIdeal K e ≤ K := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨x, hx, rfl⟩
  exact Ideal.pow_mem_of_mem K hx e he

/-- If a ring map `f` satisfies `f(x) ^ e = 0` for all `x ∈ K`, then it kills
`powIdeal K e`. -/
theorem powIdeal_le_ker {S : Type*} [CommRing S] {K : Ideal R} {e : ℕ}
    (f : R →+* S) (hf : ∀ x ∈ K, f x ^ e = 0) : powIdeal K e ≤ RingHom.ker f := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨x, hx, rfl⟩
  change f (x ^ e) = 0
  rw [map_pow]
  exact hf x hx

end PowIdeal

namespace InfinitesimalThickening

variable {A C : Type u} [CommRing A] [CommRing C] [Algebra A C]

/-! ## Exponents -/

/-- `X = (π : B → C)` has exponent `e`: `x ^ e = 0` for every `x ∈ ker π`. -/
def HasExponent (X : InfinitesimalThickening A C) (e : ℕ) : Prop :=
  ∀ x : X.carrier, x ∈ RingHom.ker X.π.toRingHom → x ^ e = 0

/-- Having exponent `e` implies having exponent `e'` for every `e' ≥ e`. -/
theorem HasExponent.mono {X : InfinitesimalThickening A C} {e e' : ℕ}
    (h : X.HasExponent e) (hle : e ≤ e') : X.HasExponent e' := by
  intro x hx
  rw [← Nat.add_sub_cancel' hle, pow_add, h x hx, zero_mul]

theorem exists_hasExponent (X : InfinitesimalThickening A C) :
    ∃ e, X.HasExponent e :=
  X.kernel_bounded

open Classical in
/-- The minimal exponent `exp(X)`: the least `e` such that `X` has exponent `e`. -/
noncomputable def exponent (X : InfinitesimalThickening A C) : ℕ :=
  Nat.find X.exists_hasExponent

theorem hasExponent_exponent (X : InfinitesimalThickening A C) :
    X.HasExponent X.exponent := by
  classical
  exact Nat.find_spec X.exists_hasExponent

/-- `X` has exponent `e` if and only if `exp(X) ≤ e`. -/
theorem exponent_le_iff (X : InfinitesimalThickening A C) {e : ℕ} :
    X.exponent ≤ e ↔ X.HasExponent e := by
  classical
  constructor
  · intro h
    exact X.hasExponent_exponent.mono h
  · intro h
    exact Nat.find_min' X.exists_hasExponent h

theorem not_hasExponent_of_lt_exponent (X : InfinitesimalThickening A C) {e : ℕ}
    (he : e < X.exponent) : ¬ X.HasExponent e := by
  intro h
  exact absurd ((X.exponent_le_iff).2 h) (Nat.not_le.2 he)

/-! ## Frobenius exponents -/

section FrobeniusExponent

variable (p : ℕ) [Fact (1 < p)]

/-- Every object has exponent `p ^ e` for some `e`: if it has exponent `n`, then it
has exponent `p ^ n ≥ n`. -/
theorem exists_hasExponent_pow (X : InfinitesimalThickening A C) :
    ∃ e, X.HasExponent (p ^ e) := by
  obtain ⟨n, hn⟩ := X.exists_hasExponent
  exact ⟨n, hn.mono (Nat.lt_pow_self Fact.out).le⟩

open Classical in
/-- The Frobenius exponent of `X = (π : B → C)`: the least `e` such that `X` has
exponent `p ^ e`, that is, such that `x ↦ x ^ (p ^ e)` kills `ker π`. -/
noncomputable def frobeniusExponent (X : InfinitesimalThickening A C) : ℕ :=
  Nat.find (X.exists_hasExponent_pow p)

theorem hasExponent_pow_frobeniusExponent (X : InfinitesimalThickening A C) :
    X.HasExponent (p ^ X.frobeniusExponent p) := by
  classical
  exact Nat.find_spec (X.exists_hasExponent_pow p)

/-- `X` has exponent `p ^ e` if and only if its Frobenius exponent is at most `e`. -/
theorem frobeniusExponent_le_iff (X : InfinitesimalThickening A C) {e : ℕ} :
    X.frobeniusExponent p ≤ e ↔ X.HasExponent (p ^ e) := by
  classical
  refine ⟨fun h ↦ (X.hasExponent_pow_frobeniusExponent p).mono ?_,
    fun h ↦ Nat.find_min' (X.exists_hasExponent_pow p) h⟩
  exact Nat.pow_le_pow_right (zero_lt_one.trans Fact.out) h

/-- The minimal exponent is at most `p` to the Frobenius exponent. -/
theorem exponent_le_pow_frobeniusExponent (X : InfinitesimalThickening A C) :
    X.exponent ≤ p ^ X.frobeniusExponent p :=
  X.exponent_le_iff.2 (X.hasExponent_pow_frobeniusExponent p)

end FrobeniusExponent

/-! ## Truncation of a surjection by `e`-th powers -/

section Truncation

variable {B : Type u} [CommRing B] [Algebra A B]

/-- The ideal of `B` generated by the `e`-th powers of elements of `ker π`. -/
def truncIdeal (π : B →ₐ[A] C) (e : ℕ) : Ideal B :=
  powIdeal (RingHom.ker π.toRingHom) e

theorem truncIdeal_le_ker (π : B →ₐ[A] C) {e : ℕ} (he : 0 < e) :
    truncIdeal π e ≤ RingHom.ker π.toRingHom :=
  powIdeal_le he

/-- The truncation `T_e(B) = B / (x ^ e : x ∈ ker π)` of a surjection
`π : B → C`, an object of `INF(C/A)`; the kernel of `T_e(B) → C` is the image
of `ker π`. -/
noncomputable def truncate (π : B →ₐ[A] C) (hπ : Function.Surjective π)
    (e : ℕ) (he : 0 < e) : InfinitesimalThickening A C where
  carrier := B ⧸ truncIdeal π e
  π := Ideal.Quotient.liftₐ (truncIdeal π e) π (fun b hb ↦
    truncIdeal_le_ker π he hb)
  surjective := by
    intro c
    obtain ⟨b, rfl⟩ := hπ c
    exact ⟨Ideal.Quotient.mk _ b, rfl⟩
  kernel_bounded := by
    refine ⟨e, ?_⟩
    intro x hx
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
    have hb : b ∈ RingHom.ker π.toRingHom := hx
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact pow_mem_powIdeal hb

variable (π : B →ₐ[A] C) (hπ : Function.Surjective π) (e : ℕ) (he : 0 < e)

/-- The truncation `T_e(B)` has exponent `e`. -/
theorem truncate_hasExponent : (truncate π hπ e he).HasExponent e := by
  intro x hx
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
  have hb : b ∈ RingHom.ker π.toRingHom := hx
  change ((Ideal.Quotient.mk (truncIdeal π e) b : B ⧸ truncIdeal π e)) ^ e = 0
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact pow_mem_powIdeal hb

/-- The quotient map `B → T_e(B)`. -/
noncomputable def truncateMk : B →ₐ[A] (truncate π hπ e he).carrier :=
  Ideal.Quotient.mkₐ A (truncIdeal π e)

theorem truncateMk_surjective : Function.Surjective (truncateMk π hπ e he) :=
  Ideal.Quotient.mkₐ_surjective A _

@[simp]
theorem truncate_π_truncateMk (b : B) :
    (truncate π hπ e he).π (truncateMk π hπ e he b) = π b :=
  rfl

theorem truncate_π_comp_truncateMk :
    (truncate π hπ e he).π.comp (truncateMk π hπ e he) = π :=
  AlgHom.ext (fun _ ↦ rfl)

variable {π hπ e he}

/-- The universal property of the truncation: an `A`-algebra map `f : B → Y` over
`C`, with `Y` of exponent `e`, factors through `B → T_e(B)`. The factorisation
is unique by `truncate_hom_ext`. -/
noncomputable def truncateLift (Y : InfinitesimalThickening A C)
    (hY : Y.HasExponent e) (f : B →ₐ[A] Y.carrier) (hf : Y.π.comp f = π) :
    Hom (truncate π hπ e he) Y where
  toAlgHom := Ideal.Quotient.liftₐ (truncIdeal π e) f (by
    intro b hb
    have hle := powIdeal_le_ker (e := e) f.toRingHom (K := RingHom.ker π.toRingHom)
      (fun x hx ↦ by
        apply hY
        change Y.π (f x) = 0
        have := congrArg (fun g ↦ g x) hf
        simp only [AlgHom.comp_apply] at this
        rw [this]
        exact hx)
    exact hle hb)
  overC := by
    apply AlgHom.ext
    intro x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
    change Y.π (f b) = π b
    exact congrArg (fun g ↦ g b) hf

@[simp]
theorem truncateLift_mk (Y : InfinitesimalThickening A C)
    (hY : Y.HasExponent e) (f : B →ₐ[A] Y.carrier) (hf : Y.π.comp f = π) (b : B) :
    (truncateLift (hπ := hπ) (he := he) Y hY f hf).toAlgHom
      (truncateMk π hπ e he b) = f b :=
  rfl

theorem truncateLift_comp_mk (Y : InfinitesimalThickening A C)
    (hY : Y.HasExponent e) (f : B →ₐ[A] Y.carrier) (hf : Y.π.comp f = π) :
    (truncateLift (hπ := hπ) (he := he) Y hY f hf).toAlgHom.comp
      (truncateMk π hπ e he) = f :=
  AlgHom.ext (fun _ ↦ rfl)

/-- Morphisms out of `T_e(B)` are determined by their composites with
`B → T_e(B)`. -/
theorem truncate_hom_ext {Y : InfinitesimalThickening A C}
    {g h : Hom (truncate π hπ e he) Y}
    (H : g.toAlgHom.comp (truncateMk π hπ e he) =
      h.toAlgHom.comp (truncateMk π hπ e he)) : g = h := by
  apply Hom.ext
  apply AlgHom.ext
  intro x
  obtain ⟨b, rfl⟩ := truncateMk_surjective π hπ e he x
  exact congrArg (fun k ↦ k b) H

/-- The quotient map `X → T_e(X)` from an object to its truncation, as a morphism
of `INF(C/A)`. -/
noncomputable def toTruncate (X : InfinitesimalThickening A C) (e : ℕ) (he : 0 < e) :
    Hom X (truncate X.π X.surjective e he) where
  toAlgHom := truncateMk X.π X.surjective e he
  overC := truncate_π_comp_truncateMk X.π X.surjective e he

@[simp]
theorem toTruncate_toAlgHom (X : InfinitesimalThickening A C) (e : ℕ) (he : 0 < e) :
    (toTruncate X e he).toAlgHom = truncateMk X.π X.surjective e he :=
  rfl

end Truncation

end InfinitesimalThickening

/-! ## The sites `INF^{(e)}` and the Frobenius levels -/

open InfinitesimalThickening

/-- The property of having exponent `e`. -/
def exponentLE (A C : Type u) [CommRing A] [CommRing C] [Algebra A C] (e : ℕ) :
    ObjectProperty (InfinitesimalThickening A C) :=
  fun X ↦ X.HasExponent e

/-- The infinitesimal site of exponent `e`, `INF^{(e)}`: the full subcategory of
`INF(C/A)` of objects having exponent `e`. For a prime `p`, the Frobenius level
`Level A C (p ^ e)` consists of the objects whose kernel is killed by `x ↦ x ^ (p ^ e)`;
it is the site denoted `INF_e` in the accompanying article. -/
abbrev Level (A C : Type u) [CommRing A] [CommRing C] [Algebra A C] (e : ℕ) :=
  (exponentLE A C e).FullSubcategory

namespace Level

variable {A C : Type u} [CommRing A] [CommRing C] [Algebra A C]

/-- The inclusion `INF^{(e)} → INF(C/A)`. -/
abbrev ι (e : ℕ) : Level A C e ⥤ InfinitesimalThickening A C :=
  (exponentLE A C e).ι

theorem exponentLE_mono {e e' : ℕ} (h : e ≤ e') :
    exponentLE A C e ≤ exponentLE A C e' :=
  fun _ hX ↦ HasExponent.mono hX h

/-- The inclusion `INF^{(e)} → INF^{(e')}` for `e ≤ e'`. -/
abbrev incl {e e' : ℕ} (h : e ≤ e') : Level A C e ⥤ Level A C e' :=
  ObjectProperty.ιOfLE (exponentLE_mono h)

/-- Every object `X` lies in `INF^{(exp(X))}`. -/
def ofObj (X : InfinitesimalThickening A C) : Level A C X.exponent :=
  ⟨X, X.hasExponent_exponent⟩

/-- Every object lies in some `INF^{(e)}`: `INF(C/A)` is the increasing union of the
subcategories `INF^{(e)}`. -/
theorem exists_level (X : InfinitesimalThickening A C) :
    ∃ e, exponentLE A C e X :=
  ⟨X.exponent, X.hasExponent_exponent⟩

/-- An object of `INF^{(e)}` has exponent `e`. -/
theorem hasExponent {e : ℕ} (X : Level A C e) : X.obj.HasExponent e := X.property

section Frobenius

variable (p : ℕ) [Fact (1 < p)]

/-- The Frobenius levels increase: an object of exponent `p ^ e` has exponent
`p ^ e'` for `e ≤ e'`. -/
theorem exponentLE_pow_mono {e e' : ℕ} (h : e ≤ e') :
    exponentLE A C (p ^ e) ≤ exponentLE A C (p ^ e') :=
  exponentLE_mono (Nat.pow_le_pow_right (zero_lt_one.trans Fact.out) h)

/-- The inclusion of Frobenius levels `Level A C (p ^ e) ⥤ Level A C (p ^ e')` for
`e ≤ e'`. -/
abbrev inclPow {e e' : ℕ} (h : e ≤ e') : Level A C (p ^ e) ⥤ Level A C (p ^ e') :=
  ObjectProperty.ιOfLE (exponentLE_pow_mono p h)

/-- Every object `X` lies in the Frobenius level `Level A C (p ^ e)` of its Frobenius
exponent `e`. -/
def ofObjFrobenius (X : InfinitesimalThickening A C) :
    Level A C (p ^ X.frobeniusExponent p) :=
  ⟨X, X.hasExponent_pow_frobeniusExponent p⟩

/-- Every object lies in some Frobenius level: `INF(C/A)` is the increasing union of
the subcategories `Level A C (p ^ e)`. -/
theorem exists_frobenius_level (X : InfinitesimalThickening A C) :
    ∃ e, exponentLE A C (p ^ e) X :=
  ⟨X.frobeniusExponent p, X.hasExponent_pow_frobeniusExponent p⟩

end Frobenius

end Level

/-! ## The truncation functor -/

namespace Level

variable {A C : Type u} [CommRing A] [CommRing C] [Algebra A C]
variable (e : ℕ) [NeZero e]

/-- The truncation functor `T_e : INF(C/A) ⥤ INF^{(e)}`, sending `X = (π : B → C)` to
`T_e(X) = B / (x ^ e : x ∈ ker π)` and a morphism `f : X → Y` to the morphism
`T_e(X) → T_e(Y)` induced by `B → B' → T_e(Y)`. It is left adjoint to the
inclusion `INF^{(e)} → INF(C/A)` (`truncationAdjunction`). -/
noncomputable def truncation : InfinitesimalThickening A C ⥤ Level A C e where
  obj X := ⟨truncate X.π X.surjective e (NeZero.pos e), truncate_hasExponent _ _ _ _⟩
  map {X Y} f := ObjectProperty.homMk
    (truncateLift (hπ := X.surjective) (he := NeZero.pos e) _
      (truncate_hasExponent Y.π Y.surjective e (NeZero.pos e))
      ((toTruncate Y e (NeZero.pos e)).toAlgHom.comp f.toAlgHom)
      (by rw [← AlgHom.comp_assoc, (toTruncate Y e _).overC, f.overC]))
  map_id X := ObjectProperty.hom_ext _
    (truncate_hom_ext (hπ := X.surjective) (he := NeZero.pos e) (AlgHom.ext fun _ ↦ rfl))
  map_comp {X _ _} _ _ := ObjectProperty.hom_ext _
    (truncate_hom_ext (hπ := X.surjective) (he := NeZero.pos e) (AlgHom.ext fun _ ↦ rfl))

@[simp]
theorem truncation_obj_obj (X : InfinitesimalThickening A C) :
    ((truncation e).obj X).obj = truncate X.π X.surjective e (NeZero.pos e) :=
  rfl

/-- The map `T_e(X) → T_e(Y)` induced by `f : X → Y` is compatible with the
quotient maps. -/
theorem toTruncate_comp_truncation_map {X Y : InfinitesimalThickening A C} (f : X ⟶ Y) :
    toTruncate X e (NeZero.pos e) ≫ ((truncation e).map f).hom =
      f ≫ toTruncate Y e (NeZero.pos e) :=
  rfl

/-- Morphisms out of `T_e(X)` in `INF^{(e)}` are determined by their composites with
the quotient map `X → T_e(X)`. -/
theorem truncation_hom_ext {X : InfinitesimalThickening A C} {Y : Level A C e}
    {g h : (truncation e).obj X ⟶ Y}
    (H : toTruncate X e (NeZero.pos e) ≫ g.hom = toTruncate X e (NeZero.pos e) ≫ h.hom) :
    g = h :=
  ObjectProperty.hom_ext _ <| truncate_hom_ext (hπ := X.surjective) (he := NeZero.pos e) <| by
    exact congrArg (fun k : X ⟶ Y.obj ↦ InfinitesimalThickening.Hom.toAlgHom k) H

/-- The hom-equivalence of the truncation adjunction: morphisms `T_e(X) → Y` with
`Y` in `INF^{(e)}` correspond to morphisms `X → Y`, by composition with the quotient
map `X → T_e(X)`. The inverse is `truncateLift`. -/
noncomputable def truncationHomEquiv (X : InfinitesimalThickening A C) (Y : Level A C e) :
    ((truncation e).obj X ⟶ Y) ≃ (X ⟶ (Level.ι e).obj Y) where
  toFun g := toTruncate X e (NeZero.pos e) ≫ g.hom
  invFun f := ObjectProperty.homMk
    (truncateLift (hπ := X.surjective) (he := NeZero.pos e) Y.obj Y.property f.toAlgHom f.overC)
  left_inv _ := truncation_hom_ext e rfl
  right_inv _ := rfl

/-- **The truncation adjunction.** For `e > 0`, the truncation functor
`T_e : INF(C/A) ⥤ INF^{(e)}` is left adjoint to the inclusion `INF^{(e)} → INF(C/A)`. -/
noncomputable def truncationAdjunction :
    truncation e ⊣ Level.ι (A := A) (C := C) e :=
  Adjunction.mkOfHomEquiv
    { homEquiv := truncationHomEquiv e
      homEquiv_naturality_left_symm _ _ := truncation_hom_ext e rfl
      homEquiv_naturality_right _ _ := rfl }

/-- The unit of the truncation adjunction is the quotient map `X → T_e(X)`. -/
@[simp]
theorem truncationAdjunction_unit_app (X : InfinitesimalThickening A C) :
    (truncationAdjunction e).unit.app X = toTruncate X e (NeZero.pos e) :=
  rfl

end Level

/-! ## Binary coproducts in `INF^{(e)}` -/

namespace Level

variable {A C : Type u} [CommRing A] [CommRing C] [Algebra A C]
variable {e : ℕ} [NeZero e]

/-- The map `B ⊗_A B' → C`, `b ⊗ b' ↦ π(b) π'(b')`, is surjective. -/
theorem tensor_surjective (X Y : InfinitesimalThickening A C) :
    Function.Surjective (Algebra.TensorProduct.productMap X.π Y.π) := by
  intro c
  obtain ⟨x, rfl⟩ := X.surjective c
  exact ⟨x ⊗ₜ 1, by simp⟩

/-- The truncation `T_e(B ⊗_A B')` of `B ⊗_A B' → C`, which is the coproduct of
`B → C` and `B' → C` in `INF^{(e)}`. -/
noncomputable def coprodThickening (e : ℕ) [NeZero e]
    (X Y : InfinitesimalThickening A C) : InfinitesimalThickening A C :=
  truncate (Algebra.TensorProduct.productMap X.π Y.π) (tensor_surjective X Y) e
    (NeZero.pos e)

/-- The coproduct of two objects of `INF^{(e)}`. -/
noncomputable def coprod (X Y : Level A C e) : Level A C e :=
  ⟨coprodThickening e X.obj Y.obj, truncate_hasExponent _ _ _ _⟩

/-- The first coprojection, induced by `b ↦ b ⊗ 1`. -/
noncomputable def inl (X Y : Level A C e) : X ⟶ coprod X Y :=
  ObjectProperty.homMk
    { toAlgHom := (truncateMk _ (tensor_surjective X.obj Y.obj) e (NeZero.pos e)).comp
        Algebra.TensorProduct.includeLeft
      overC := by
        apply AlgHom.ext
        intro x
        change Algebra.TensorProduct.productMap X.obj.π Y.obj.π (x ⊗ₜ 1) = X.obj.π x
        simp }

/-- The second coprojection, induced by `b' ↦ 1 ⊗ b'`. -/
noncomputable def inr (X Y : Level A C e) : Y ⟶ coprod X Y :=
  ObjectProperty.homMk
    { toAlgHom := (truncateMk _ (tensor_surjective X.obj Y.obj) e (NeZero.pos e)).comp
        Algebra.TensorProduct.includeRight
      overC := by
        apply AlgHom.ext
        intro y
        change Algebra.TensorProduct.productMap X.obj.π Y.obj.π (1 ⊗ₜ y) = Y.obj.π y
        simp }

/-- The morphism out of the coproduct induced by `f` and `g`, given on
`B ⊗_A B'` by `b ⊗ b' ↦ f(b) g(b')`. -/
noncomputable def coprodDesc {X Y T : Level A C e} (f : X ⟶ T) (g : Y ⟶ T) :
    coprod X Y ⟶ T :=
  ObjectProperty.homMk
    (truncateLift (hπ := tensor_surjective X.obj Y.obj) (he := NeZero.pos e)
      T.obj T.property
      (Algebra.TensorProduct.productMap f.hom.toAlgHom g.hom.toAlgHom) (by
        apply Algebra.TensorProduct.ext'
        intro x y
        simp only [AlgHom.comp_apply, Algebra.TensorProduct.productMap_apply_tmul,
          map_mul]
        rw [f.hom.overC_apply, g.hom.overC_apply]))

theorem inl_coprodDesc {X Y T : Level A C e} (f : X ⟶ T) (g : Y ⟶ T) :
    inl X Y ≫ coprodDesc f g = f := by
  apply ObjectProperty.hom_ext
  apply InfinitesimalThickening.Hom.ext
  apply AlgHom.ext
  intro x
  change Algebra.TensorProduct.productMap f.hom.toAlgHom g.hom.toAlgHom (x ⊗ₜ 1) =
    f.hom.toAlgHom x
  simp

theorem inr_coprodDesc {X Y T : Level A C e} (f : X ⟶ T) (g : Y ⟶ T) :
    inr X Y ≫ coprodDesc f g = g := by
  apply ObjectProperty.hom_ext
  apply InfinitesimalThickening.Hom.ext
  apply AlgHom.ext
  intro y
  change Algebra.TensorProduct.productMap f.hom.toAlgHom g.hom.toAlgHom (1 ⊗ₜ y) =
    g.hom.toAlgHom y
  simp

/-- Morphisms out of the coproduct are determined by their composites with the
coprojections, since `b ⊗ b' = (b ⊗ 1)(1 ⊗ b')`. -/
theorem coprod_hom_ext {X Y T : Level A C e} {φ ψ : coprod X Y ⟶ T}
    (hl : inl X Y ≫ φ = inl X Y ≫ ψ) (hr : inr X Y ≫ φ = inr X Y ≫ ψ) : φ = ψ := by
  apply ObjectProperty.hom_ext
  apply truncate_hom_ext (hπ := tensor_surjective X.obj Y.obj) (he := NeZero.pos e)
  apply Algebra.TensorProduct.ext'
  intro x y
  let mk : X.obj.carrier ⊗[A] Y.obj.carrier →ₐ[A] (coprod X Y).obj.carrier :=
    truncateMk (Algebra.TensorProduct.productMap X.obj.π Y.obj.π)
      (tensor_surjective X.obj Y.obj) e (NeZero.pos e)
  have hx : φ.hom.toAlgHom (mk (x ⊗ₜ 1)) = ψ.hom.toAlgHom (mk (x ⊗ₜ 1)) :=
    congrArg (fun k ↦ k.hom.toAlgHom x) hl
  have hy : φ.hom.toAlgHom (mk (1 ⊗ₜ y)) = ψ.hom.toAlgHom (mk (1 ⊗ₜ y)) :=
    congrArg (fun k ↦ k.hom.toAlgHom y) hr
  have hxy : mk (x ⊗ₜ[A] y) = mk (x ⊗ₜ[A] (1 : Y.obj.carrier)) *
      mk ((1 : X.obj.carrier) ⊗ₜ[A] y) := by
    rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  change φ.hom.toAlgHom (mk (x ⊗ₜ[A] y)) = ψ.hom.toAlgHom (mk (x ⊗ₜ[A] y))
  rw [hxy, map_mul, map_mul, hx, hy]

/-- The coproduct cofan. -/
noncomputable def coprodCofan (X Y : Level A C e) : BinaryCofan X Y :=
  BinaryCofan.mk (inl X Y) (inr X Y)

/-- The coproduct cofan is a colimit. -/
noncomputable def coprodCofanIsColimit (X Y : Level A C e) :
    IsColimit (coprodCofan X Y) :=
  BinaryCofan.IsColimit.mk _ (fun f g ↦ coprodDesc f g)
    (fun f g ↦ inl_coprodDesc f g) (fun f g ↦ inr_coprodDesc f g)
    (fun f g _ hl hr ↦ coprod_hom_ext (hl.trans (inl_coprodDesc f g).symm)
      (hr.trans (inr_coprodDesc f g).symm))

/-- For `e > 0`, `INF^{(e)}` has binary coproducts, that is, binary products in the site
orientation. -/
instance hasBinaryCoproducts : HasBinaryCoproducts (Level A C e) := by
  have : ∀ {X Y : Level A C e}, HasColimit (pair X Y) := fun {X Y} ↦
    ⟨⟨⟨coprodCofan X Y, coprodCofanIsColimit X Y⟩⟩⟩
  exact hasBinaryCoproducts_of_hasColimit_pair _

end Level

/-! ## Sections and the Čech nerve -/

namespace InfinitesimalThickening

variable {A C : Type u} [CommRing A] [CommRing C] [Algebra A C]

/-- The set `S(X)` of set-theoretic sections `s : C → B` of `π : B → C`. -/
def Sections (X : InfinitesimalThickening A C) : Type u :=
  {s : C → X.carrier // ∀ c, X.π (s c) = c}

/-- `S(X)` is nonempty since `π` is surjective. -/
theorem sections_nonempty (X : InfinitesimalThickening A C) : Nonempty X.Sections :=
  ⟨⟨fun c ↦ (X.surjective c).choose, fun c ↦ (X.surjective c).choose_spec⟩⟩

/-- The map `S(X) → S(Y)`, `s ↦ f ∘ s`, induced by a morphism `f : X → Y`. -/
def Sections.map {X Y : InfinitesimalThickening A C} (f : Hom X Y)
    (s : X.Sections) : Y.Sections :=
  ⟨fun c ↦ f.toAlgHom (s.1 c), fun c ↦ by rw [f.overC_apply, s.2 c]⟩

@[simp]
theorem Sections.map_apply {X Y : InfinitesimalThickening A C} (f : Hom X Y)
    (s : X.Sections) (c : C) : (Sections.map f s).1 c = f.toAlgHom (s.1 c) :=
  rfl

/-- The canonical presentation `A[x_c : c ∈ C] → C`, `x_c ↦ c`. -/
noncomputable def presentationπ : MvPolynomial C A →ₐ[A] C :=
  MvPolynomial.aeval id

theorem presentationπ_surjective :
    Function.Surjective (presentationπ (A := A) (C := C)) :=
  fun c ↦ ⟨MvPolynomial.X c, by simp [presentationπ]⟩

/-- The presentation `A[x_{i,c} : i ∈ [n], c ∈ C] → C`, `x_{i,c} ↦ c`. -/
noncomputable def cechπ (n : ℕ) : MvPolynomial (Fin (n + 1) × C) A →ₐ[A] C :=
  MvPolynomial.aeval Prod.snd

theorem cechπ_surjective (n : ℕ) : Function.Surjective (cechπ (A := A) (C := C) n) :=
  fun c ↦ ⟨MvPolynomial.X (0, c), by simp [cechπ]⟩

/-- The `A`-algebra map `A[x_{i,c}] → B`, `x_{i,c} ↦ sᵢ(c)`, defined by an
`(n+1)`-tuple of sections; it lies over `C` (`sectionsAlgHom_over`). -/
noncomputable def sectionsAlgHom (Y : InfinitesimalThickening A C) {n : ℕ}
    (s : Fin (n + 1) → Y.Sections) : MvPolynomial (Fin (n + 1) × C) A →ₐ[A] Y.carrier :=
  MvPolynomial.aeval fun ic ↦ (s ic.1).1 ic.2

theorem sectionsAlgHom_over (Y : InfinitesimalThickening A C) {n : ℕ}
    (s : Fin (n + 1) → Y.Sections) :
    Y.π.comp (sectionsAlgHom Y s) = cechπ n := by
  apply MvPolynomial.algHom_ext
  intro ic
  simp [sectionsAlgHom, cechπ, (s ic.1).2 ic.2]

end InfinitesimalThickening

namespace Level

variable {A C : Type u} [CommRing A] [CommRing C] [Algebra A C]
variable (e : ℕ) [NeZero e]

/-- The object `X^{(e)}(n)` of `INF^{(e)}`: the truncation of
`A[x_{i,c} : i ∈ [n], c ∈ C] → C`. Since it corepresents `(n+1)`-tuples of
sections (`cechHomEquiv`), it is an `(n+1)`-fold coproduct of `X^{(e)}(0)`. -/
noncomputable def cechObj (n : ℕ) : Level A C e :=
  ⟨truncate (cechπ n) (cechπ_surjective n) e (NeZero.pos e),
    truncate_hasExponent _ _ _ _⟩

/-- The quotient map `A[x_{i,c}] → X^{(e)}(n)`. -/
noncomputable abbrev cechMk (n : ℕ) :
    MvPolynomial (Fin (n + 1) × C) A →ₐ[A] (cechObj (A := A) (C := C) e n).obj.carrier :=
  truncateMk (cechπ n) (cechπ_surjective n) e (NeZero.pos e)

variable {e}

/-- Morphisms out of `X^{(e)}(n)` are determined by their values on the variables. -/
theorem cech_hom_ext {n : ℕ} {Y : Level A C e} {g h : cechObj e n ⟶ Y}
    (H : ∀ i c, g.hom.toAlgHom (cechMk e n (MvPolynomial.X (i, c))) =
      h.hom.toAlgHom (cechMk e n (MvPolynomial.X (i, c)))) : g = h := by
  apply ObjectProperty.hom_ext
  apply truncate_hom_ext (hπ := cechπ_surjective n) (he := NeZero.pos e)
  apply MvPolynomial.algHom_ext
  rintro ⟨i, c⟩
  exact H i c

/-- The morphism `X^{(e)}(m) → X^{(e)}(n)` induced by a map `θ : [m] → [n]`, renaming
`x_{i,c}` to `x_{θ(i),c}`. -/
noncomputable def cechMap {m n : ℕ} (f : Fin (m + 1) → Fin (n + 1)) :
    cechObj (A := A) (C := C) e m ⟶ cechObj e n :=
  ObjectProperty.homMk
    (truncateLift (hπ := cechπ_surjective m) (he := NeZero.pos e)
      (cechObj e n).obj (cechObj e n).property
      ((cechMk e n).comp (MvPolynomial.rename (Prod.map f id))) (by
        apply MvPolynomial.algHom_ext
        rintro ⟨i, c⟩
        change cechπ n (MvPolynomial.rename (Prod.map f id) (MvPolynomial.X (i, c))) =
          cechπ m (MvPolynomial.X (i, c))
        simp [cechπ]))

@[simp]
theorem cechMap_X {m n : ℕ} (f : Fin (m + 1) → Fin (n + 1)) (i : Fin (m + 1)) (c : C) :
    (cechMap (A := A) (C := C) (e := e) f).hom.toAlgHom (cechMk e m (MvPolynomial.X (i, c))) =
      cechMk e n (MvPolynomial.X (f i, c)) := by
  change (cechMk e n) (MvPolynomial.rename (Prod.map f id) (MvPolynomial.X (i, c))) = _
  simp

theorem cechMap_id (n : ℕ) :
    cechMap (A := A) (C := C) (e := e) (id : Fin (n + 1) → Fin (n + 1)) = 𝟙 _ := by
  apply cech_hom_ext
  intro i c
  rw [cechMap_X]
  rfl

theorem cechMap_comp {m n k : ℕ} (f : Fin (m + 1) → Fin (n + 1))
    (g : Fin (n + 1) → Fin (k + 1)) :
    cechMap (A := A) (C := C) (e := e) (g ∘ f) = cechMap f ≫ cechMap g := by
  apply cech_hom_ext
  intro i c
  rw [cechMap_X]
  change _ = (cechMap g).hom.toAlgHom ((cechMap f).hom.toAlgHom
    (cechMk e m (MvPolynomial.X (i, c))))
  rw [cechMap_X, cechMap_X]
  rfl

variable (e) in
/-- The cosimplicial object `X^{(e)}(•)` of `INF^{(e)}`; in the site orientation it is
the Čech nerve of the weakly final object `X^{(e)}(0)`. -/
noncomputable def cechNerve : SimplexCategory ⥤ Level A C e where
  obj n := cechObj e n.len
  map f := cechMap f.toOrderHom
  map_id n := by
    exact cechMap_id n.len
  map_comp f g := by
    rw [← cechMap_comp]
    rfl

/-- Morphisms `X^{(e)}(n) → Y` correspond to `(n+1)`-tuples `(s_0, …, s_n)` of
sections of `Y`, via `x_{i,c} ↦ sᵢ(c)`. -/
noncomputable def cechHomEquiv (n : ℕ) (Y : Level A C e) :
    (cechObj e n ⟶ Y) ≃ (Fin (n + 1) → Y.obj.Sections) where
  toFun g i := ⟨fun c ↦ g.hom.toAlgHom (cechMk e n (MvPolynomial.X (i, c))),
    fun c ↦ by
      rw [g.hom.overC_apply]
      change cechπ n (MvPolynomial.X (i, c)) = c
      simp [cechπ]⟩
  invFun s := ObjectProperty.homMk
    (truncateLift (hπ := cechπ_surjective n) (he := NeZero.pos e) Y.obj Y.property
      (sectionsAlgHom Y.obj s) (sectionsAlgHom_over Y.obj s))
  left_inv g := by
    apply cech_hom_ext
    intro i c
    dsimp [ObjectProperty.homMk, truncateLift, cechMk, truncateMk]
    exact MvPolynomial.aeval_X _ _
  right_inv s := by
    funext i
    apply Subtype.ext
    funext c
    change sectionsAlgHom Y.obj s (MvPolynomial.X (i, c)) = (s i).1 c
    simp [sectionsAlgHom]

@[simp]
theorem cechHomEquiv_apply (n : ℕ) (Y : Level A C e) (g : cechObj e n ⟶ Y)
    (i : Fin (n + 1)) (c : C) :
    (cechHomEquiv n Y g i).1 c = g.hom.toAlgHom (cechMk e n (MvPolynomial.X (i, c))) :=
  rfl

/-- Under `cechHomEquiv`, precomposition with the map induced by `θ` corresponds
to `s ↦ s ∘ θ`. -/
theorem cechHomEquiv_cechMap {m n : ℕ} (f : Fin (m + 1) → Fin (n + 1))
    (Y : Level A C e) (g : cechObj e n ⟶ Y) :
    cechHomEquiv m Y (cechMap f ≫ g) = cechHomEquiv n Y g ∘ f := by
  funext i
  apply Subtype.ext
  funext c
  change g.hom.toAlgHom ((cechMap f).hom.toAlgHom (cechMk e m (MvPolynomial.X (i, c)))) = _
  rw [cechMap_X]
  rfl

/-- `cechHomEquiv` is natural in `Y`. -/
theorem cechHomEquiv_comp (n : ℕ) {Y Z : Level A C e} (g : cechObj e n ⟶ Y)
    (h : Y ⟶ Z) :
    cechHomEquiv n Z (g ≫ h) = fun i ↦ Sections.map h.hom (cechHomEquiv n Y g i) := by
  funext i
  apply Subtype.ext
  funext c
  rfl

/-- Every object of `INF^{(e)}` receives a morphism from `X^{(e)}(0)`: in the site
orientation, `X^{(e)}(0)` is weakly final. -/
theorem nonempty_hom_cechObj_zero (Y : Level A C e) : Nonempty (cechObj e 0 ⟶ Y) := by
  obtain ⟨s⟩ := Y.obj.sections_nonempty
  exact ⟨(cechHomEquiv 0 Y).symm (fun _ ↦ s)⟩

end Level

end AffineCrystalline.InfinitesimalSite
