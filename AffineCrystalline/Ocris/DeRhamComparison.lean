import AffineCrystalline.Ocris.Filtration
import AffineCrystalline.Ocris.DeRham
import AffineCrystalline.Homology.CosimplicialTot

/-!
# The affine de Rham comparison for `ocris` via the Bhatt–de Jong lemma

Let `e` be a positive integer.  Write `X^{(e)}(•)` for the Čech
nerve of the weakly initial object of `INF^{(e)}` (`Level A C e`), and
`D(n) = Ocris(X^{(e)}(n))`, a PD envelope of `A[x_{i,c}] → C`
(`ocrisCech_isEnvelope`).  The cosimplicial cochain complex

  `Kc[n] = Ω^•_{D(n)}`   (`levelCechDeRham`)

gives a double complex with terms `Ω^q_{D(n)}`, and a chain

  `lim I^•  ~  Č^•(Ocris)  ≅  Ω^0_{D(•)}  ←  Tot  →  Ω^•_{D(0)}`.

The first link is the Čech comparison (`ocrisCechZigzag`), the second is the
zero-form identification (`levelDeRhamZeroIso`), and the last two arrows are
the two projections of the Bhatt–de Jong lemma.  These projections are
quasi-isomorphisms given the two algebraic inputs of [Stacks, Tag 07LG]:

* `FirstVertexQuasiIso`: the first-vertex maps `Ω^•_{D(0)} → Ω^•_{D(n)}` are
  quasi-isomorphisms (relative PD Poincaré lemma);
* `PositiveCechExact`: for `q ≥ 1` the alternating complex of
  `n ↦ Ω^q_{D(n)}` is exact (vanishing lemma).

`affineDeRhamComparison_of_quasiIso_of_exact` and
`crystallineCohomologyIsoDeRham_of_quasiIso_of_exact` are stated in terms of
these two inputs; their identification of `lim I^•` with `RΓ(INF(C/A), Ocris)`
uses that `e! = 0` in `A` (`ocrisDerivedGlobalSectionsIsoLimComplex`).  For the
Frobenius level `e = p ^ f`, the site `INF_f` of the accompanying article, this is
the condition `(p ^ f)! = 0` in `A`.  Both inputs hold for every `e > 0` with
`e! = 0` in `A`: they are proved in
`AffineCrystalline.Ocris.CechPoincare` (`firstVertexQuasiIso`) and
`AffineCrystalline.Ocris.CechVanishing` (`positiveCechExact`), where the
resulting comparison theorems are recorded as
`affineDeRhamComparison` and
`crystallineCohomologyIsoDeRham`.

## Main definitions

* `Homology.QuasiIsoEquiv`: the equivalence relation on cochain complexes
  generated by quasi-isomorphisms.
* `EnvelopeFamily.ocrisDeRhamZeroIso`, `EnvelopeFamily.levelDeRhamZeroIso`: the
  identification of the degree-zero part of the PD de Rham diagram with `ocris`.
* `EnvelopeFamily.levelCechDeRham`: the cosimplicial complex `n ↦ Ω^•_{D(n)}`.
* `EnvelopeFamily.FirstVertexQuasiIso`, `EnvelopeFamily.PositiveCechExact`: the
  two inputs of the Bhatt–de Jong lemma.
* `EnvelopeFamily.ocrisDerivedGlobalSectionsIsoLimComplex`:
  `RΓ(INF(C/A), Ocris)` is represented by `lim I^•` on `INF^{(e)}` if `e! = 0` in `A`.

## Main results

* `Homology.QuasiIsoEquiv.nonempty_homology_iso`: equivalent complexes have isomorphic
  cohomology.
* `EnvelopeFamily.affineDeRhamComparison_of_quasiIso_of_exact`: given both inputs, `lim I^•` is
  connected to `Ω^•_{D(0)}` by a zigzag of quasi-isomorphisms.
* `EnvelopeFamily.crystallineCohomologyIsoDeRham_of_quasiIso_of_exact`: given both inputs
  and `e! = 0` in `A`, `H^k(RΓ(INF(C/A), Ocris)) ≅ H^k(Ω^•_{D(0)})`.

## References

* [Stacks Project, Tag 07LG](https://stacks.math.columbia.edu/tag/07LG)
* [Stacks Project, Tag 07LM](https://stacks.math.columbia.edu/tag/07LM)
* [Stacks Project, Tag 07JM](https://stacks.math.columbia.edu/tag/07JM)
* B. Bhatt, A. J. de Jong, *Crystalline cohomology and de Rham cohomology*,
  arXiv:1110.5001
-/

open CategoryTheory CategoryTheory.Limits
open scoped Simplicial

universe v u

namespace AffineCrystalline.Homology

variable {R : Type u} [Ring R]

/-- Two cochain complexes are *quasi-isomorphism equivalent* if they are
connected by a finite zigzag of quasi-isomorphisms (equivalently, they become
isomorphic in the derived category). -/
inductive QuasiIsoEquiv :
    CochainComplex (ModuleCat.{v} R) ℕ → CochainComplex (ModuleCat.{v} R) ℕ → Prop
  | ofHom {X Y : CochainComplex (ModuleCat.{v} R) ℕ} (f : X ⟶ Y) [QuasiIso f] :
      QuasiIsoEquiv X Y
  | symm {X Y : CochainComplex (ModuleCat.{v} R) ℕ} :
      QuasiIsoEquiv X Y → QuasiIsoEquiv Y X
  | trans {X Y Z : CochainComplex (ModuleCat.{v} R) ℕ} :
      QuasiIsoEquiv X Y → QuasiIsoEquiv Y Z → QuasiIsoEquiv X Z

namespace QuasiIsoEquiv

theorem refl (X : CochainComplex (ModuleCat.{v} R) ℕ) : QuasiIsoEquiv X X :=
  ofHom (𝟙 X)

theorem of_iso {X Y : CochainComplex (ModuleCat.{v} R) ℕ} (e : X ≅ Y) : QuasiIsoEquiv X Y :=
  ofHom e.hom

/-- Quasi-isomorphism equivalent complexes have isomorphic cohomology. -/
theorem nonempty_homology_iso {X Y : CochainComplex (ModuleCat.{v} R) ℕ} (h : QuasiIsoEquiv X Y)
    (n : ℕ) : Nonempty (X.homology n ≅ Y.homology n) := by
  induction h with
  | ofHom f => exact ⟨isoOfQuasiIsoAt f n⟩
  | symm _ ih => exact ⟨ih.some.symm⟩
  | trans _ _ ih ih' => exact ⟨ih.some ≪≫ ih'.some⟩

end QuasiIsoEquiv

/-- Complexes connected by a zigzag `X → Z ← Y` of quasi-isomorphisms are
quasi-isomorphism equivalent. -/
theorem _root_.AffineCrystalline.Cohomology.Cech.Zigzag.quasiIsoEquiv {R : Type u} [CommRing R]
    {X Y : CochainComplex (ModuleCat.{v + 1} R) ℕ} (z : Cohomology.Cech.Zigzag X Y) :
    QuasiIsoEquiv X Y :=
  have := z.left_quasiIso
  have := z.right_quasiIso
  (QuasiIsoEquiv.ofHom z.left).trans (QuasiIsoEquiv.ofHom z.right).symm

end AffineCrystalline.Homology

namespace AffineCrystalline.InfinitesimalSite

open Homology

variable {A C : Type u} [CommRing A] [CommRing C] [Algebra A C]
variable {I : Ideal A} {γ : DividedPowers I}

namespace EnvelopeFamily

variable (E : EnvelopeFamily (A := A) (C := C) (γ := γ))

/-! ## Zero forms -/

/-- The zero-form identification `Ω^0_{D} ≅ D`, natural on thickenings. -/
noncomputable def ocrisDeRhamZeroIso :
    ocrisDeRhamComplex E ⋙ HomologicalComplex.eval (ModuleCat.{u + 1} A) (ComplexShape.up ℕ) 0 ≅
      ocrisModuleLargeOnThickening E :=
  NatIso.ofComponents
    (fun X ↦
      let z := (exteriorPower.zeroEquiv (E.envelope X).carrier
        (PDKaehler (A := A) (E.envelope X).dividedPowers)).restrictScalars A
      { hom := ModuleCat.ofHom (uliftLinearMap z.toLinearMap)
        inv := ModuleCat.ofHom (uliftLinearMap z.symm.toLinearMap)
        hom_inv_id := by
          apply ModuleCat.hom_ext
          ext x
          apply ULift.down_injective
          exact z.symm_apply_apply x.down
        inv_hom_id := by
          apply ModuleCat.hom_ext
          ext x
          apply ULift.down_injective
          exact z.apply_symm_apply x.down })
    (by
      intro X Y f
      apply ModuleCat.hom_ext
      ext x
      apply ULift.down_injective
      exact congrArg (fun h ↦ h x.down)
        (AffineCrystalline.DeRham.zeroEquiv_comp_pdExteriorMap_zero
          (E.envelope X).dividedPowers (E.envelope Y).dividedPowers
          (EnvelopeChoice.comparison f (E.envelope X) (E.envelope Y))
          (EnvelopeChoice.comparison_spec f
            (E.envelope X) (E.envelope Y)).2))

/-- The covariant and doubly-opposite forms of the `ocris` module diagram
agree. -/
noncomputable def ocrisModuleLargeOnThickeningIso :
    ocrisModuleLargeOnThickening E ≅
      CategoryTheory.opOp (InfinitesimalThickening A C) ⋙ ocrisModuleLarge E :=
  NatIso.ofComponents (fun _ ↦ Iso.refl _) (fun _ ↦ rfl)

section Level

variable (p : ℕ) [Fact p.Prime] [IsCrystallineBase p A I]
variable (hIC : I.map (algebraMap A C) = ⊥)
variable (e : ℕ) [NeZero e]

/-- On `INF^{(e)}`, the degree-zero part of the PD de Rham diagram is the `ocris`
diagram. -/
noncomputable def levelDeRhamZeroIso :
    Level.ι e ⋙ ocrisDeRhamComplex E ⋙
        HomologicalComplex.eval (ModuleCat.{u + 1} A) (ComplexShape.up ℕ) 0 ≅
      E.levelOcrisModule p hIC e :=
  Functor.isoWhiskerLeft (Level.ι e)
    (E.ocrisDeRhamZeroIso ≪≫ E.ocrisModuleLargeOnThickeningIso)

/-! ## The cosimplicial PD de Rham complex -/

/-- The cosimplicial cochain complex `n ↦ Ω^•_{D(n)}`, `D(n) = Ocris(X^{(e)}(n))`. -/
noncomputable abbrev levelCechDeRham :
    CosimplicialObject (CochainComplex (ModuleCat.{u + 1} A) ℕ) :=
  Level.cechNerve e ⋙ Level.ι e ⋙ ocrisDeRhamComplex E

/-- The degree-zero row of the double complex `Ω^q_{D(n)}`, namely the
alternating complex of `n ↦ Ω^0_{D(n)}`, is the Čech complex of `ocris`. -/
noncomputable def levelCechDeRhamComponentZeroIso :
    RawBi.componentComplex (E.levelCechDeRham e) 0 ≅ E.ocrisCechComplex p hIC e :=
  (AlgebraicTopology.alternatingCofaceMapComplex (ModuleCat.{u + 1} A)).mapIso
    (Functor.isoWhiskerLeft (Level.cechNerve e) (E.levelDeRhamZeroIso p hIC e))

/-- **The relative PD Poincaré property of `INF^{(e)}`.**  The first-vertex maps
`Ω^•_{D(0)} → Ω^•_{D(n)}` are quasi-isomorphisms for all `n`.  This is the
first input of the Bhatt–de Jong lemma; it holds for every `e > 0` with `e! = 0` in
`A` by
`firstVertexQuasiIso`. -/
def FirstVertexQuasiIso : Prop :=
  ∀ n : ℕ, QuasiIso ((E.levelCechDeRham e).map (SimplexCategory.const ⦋0⦌ ⦋n⦌ 0))

/-- **The vanishing property of `INF^{(e)}`.**  For `q ≥ 1`, the alternating complex
of the cosimplicial module `n ↦ Ω^q_{D(n)}` is exact.  This is the second input
of the Bhatt–de Jong lemma; it holds for every `e > 0` with `e! = 0` in `A` by
`positiveCechExact`. -/
def PositiveCechExact : Prop :=
  ∀ q n : ℕ, (RawBi.componentComplex (E.levelCechDeRham e) (q + 1)).ExactAt n

end Level

section Comparison

variable (p : ℕ) [Fact p.Prime] [IsCrystallineBase p A I]
variable (hIC : I.map (algebraMap A C) = ⊥)
variable (n : ℕ) [NeZero n]

/-- If `n! = 0` in `A`, the derived global sections `RΓ(INF(C/A), Ocris)` are
represented by `lim I^•`, where `I^•` is the chosen injective resolution of
`ocris` on `INF^{(n)}`. -/
noncomputable def ocrisDerivedGlobalSectionsIsoLimComplex
    (hn : ((Nat.factorial n : ℕ) : A) = 0) :
    ocrisDerivedGlobalSections E ≅
      (HomotopyCategory.quotient (ModuleCat.{u + 1} A) (ComplexShape.up ℕ)).obj
        (Cohomology.Cech.limComplex (injectiveResolution (E.levelOcrisModule p hIC n))) :=
  E.ocrisDerivedGlobalSectionsIsoLevel p hIC n hn ≪≫
    E.levelOcrisDerivedGlobalSectionsIsoLimComplex p hIC n

/-- **Affine de Rham comparison.**  Given the relative PD Poincaré property and
the vanishing property of `INF^{(n)}`, the complex `lim I^•` computing `RΓ(Ocris)`
on `INF^{(n)}` (hence, by `ocrisDerivedGlobalSectionsIsoLimComplex`, on
`INF(C/A)` when `n! = 0` in `A`) is connected by a zigzag of quasi-isomorphisms to
the PD de Rham complex `Ω^•_{D(0)}` of the PD envelope `D(0)` of
`A[x_c : c ∈ C] → C`.  See `affineDeRhamComparison` for the
version with both inputs discharged. -/
theorem affineDeRhamComparison_of_quasiIso_of_exact (hP : E.FirstVertexQuasiIso n)
    (hV : E.PositiveCechExact n) :
    QuasiIsoEquiv
      (Cohomology.Cech.limComplex (injectiveResolution (E.levelOcrisModule p hIC n)))
      ((ocrisDeRhamComplex E).obj (Level.cechObj n 0).obj) := by
  let Kc := E.levelCechDeRham n
  have hrow := RawBi.bhattDeJong_row Kc hV
  have hcol := RawBi.bhattDeJong_column Kc hP
  have h1 : QuasiIsoEquiv
      (Cohomology.Cech.limComplex (injectiveResolution (E.levelOcrisModule p hIC n)))
      (E.ocrisCechComplex p hIC n) :=
    (E.ocrisCechZigzag p hIC n).quasiIsoEquiv
  have h2 : QuasiIsoEquiv (E.ocrisCechComplex p hIC n) (RawBi.ofCosimplicial Kc).totComplex :=
    ((QuasiIsoEquiv.of_iso (E.levelCechDeRhamComponentZeroIso p hIC n)).symm.trans
      (QuasiIsoEquiv.of_iso (RawBi.rowZeroComplexIso Kc)).symm).trans
      (QuasiIsoEquiv.ofHom (RawBi.ofCosimplicial Kc).rowZeroProj).symm
  have h3 : QuasiIsoEquiv (RawBi.ofCosimplicial Kc).totComplex
      ((ocrisDeRhamComplex E).obj (Level.cechObj n 0).obj) :=
    (QuasiIsoEquiv.ofHom (RawBi.ofCosimplicial Kc).colZeroProj).trans
      (QuasiIsoEquiv.of_iso (RawBi.colZeroComplexIso Kc))
  exact (h1.trans h2).trans h3

include p hIC in
/-- **Crystalline cohomology is PD de Rham cohomology (affine case).**  Given the
relative PD Poincaré property and the vanishing property of `INF^{(n)}`, with
`n! = 0` in `A`, the `k`-th cohomology of `RΓ(INF(C/A), Ocris)` is isomorphic to the
`k`-th cohomology of the PD de Rham complex of the envelope `D(0)`.  See
`crystallineCohomologyIsoDeRham` for the version with both inputs
discharged. -/
theorem crystallineCohomologyIsoDeRham_of_quasiIso_of_exact
    (hn : ((Nat.factorial n : ℕ) : A) = 0) (hP : E.FirstVertexQuasiIso n)
    (hV : E.PositiveCechExact n) (k : ℕ) :
    Nonempty (((HomotopyCategory.homologyFunctor (ModuleCat.{u + 1} A) (ComplexShape.up ℕ) k).obj
        (ocrisDerivedGlobalSections E)) ≅
      ((ocrisDeRhamComplex E).obj (Level.cechObj n 0).obj).homology k) := by
  obtain ⟨φ⟩ :=
    (E.affineDeRhamComparison_of_quasiIso_of_exact p hIC n hP hV).nonempty_homology_iso k
  exact ⟨(HomotopyCategory.homologyFunctor _ _ k).mapIso
      (E.ocrisDerivedGlobalSectionsIsoLimComplex p hIC n hn) ≪≫
    (HomotopyCategory.homologyFunctorFactors _ _ k).app _ ≪≫ φ⟩

end Comparison

end EnvelopeFamily

end AffineCrystalline.InfinitesimalSite
