/-!
# Divided power Kähler differentials

Let `A → B` be a ring map and `δ` a divided power structure on an ideal `J ⊆ B`.
A *divided power `A`-derivation* `θ : B → M` is an `A`-linear derivation such that
`θ (x^[n]) = x^[n-1] • θ x` for all `x ∈ J` and `n ≥ 1`. The module
`Ω_{B,δ}` of PD Kähler differentials is the quotient of `Ω[B⁄A]` by the
`B`-submodule generated by the elements `d(x^[n]) - x^[n-1] dx`; it carries the
universal divided power derivation.

We then introduce divided power envelopes through their universal property and
prove that, for the divided power envelope `D` of `(B, J)` relative to `(A, I, γ)`,
the canonical map `D ⊗_B Ω[B⁄A] → Ω_{D,δ}` is an isomorphism.

## Main definitions

* `IsPDDerivation`: the property of being a divided power derivation.
* `pdRelations`: the submodule of `Ω[B⁄A]` generated by the divided power relations.
* `PDKaehler`: the module `Ω_{B,δ}` of PD Kähler differentials.
* `pdD`: the universal divided power derivation `B → Ω_{B,δ}`.
* `PDKaehler.lift`: the `B`-linear map `Ω_{B,δ} → M` induced by a divided power
  derivation `θ : B → M`.
* `IsDPEnvelope`: the universal property of the divided power envelope `D_{P,γ}(J)`.
* `DPEnvelopeChoice`, `HasDPEnvelope`, `dpEnvelope`: a chosen envelope, given the
  existence of one.
* `pdKaehlerDpEnvelopeComparison`: the comparison map `D ⊗_B Ω[B⁄A] → Ω_{D,δ}`.

## Main results

* `pdD_isPDDerivation`, `PDKaehler.lift_comp`, `PDKaehler.lift_unique`: the universal
  property of `(Ω_{B,δ}, pdD)`.
* `IsDPEnvelope.algHom_ext`: divided power morphisms out of an envelope are determined
  by their restriction to `P`.
* `IsDPEnvelope.pdDerivation_ext`: divided power derivations out of an envelope are
  determined by their restriction to `P`.
* `isPDDerivation_sndHom_comp`: the second component of a divided power morphism
  `D → D ⊕ M` lifting the identity is a divided power derivation.
* `existsUnique_pdDerivation_extension`: an `A`-derivation of `B` with values in a
  `D`-module extends uniquely to a divided power derivation of the envelope `D`.
* `pdKaehler_dpEnvelope`: for a divided power envelope `D`, the comparison map
  `D ⊗_B Ω[B⁄A] → Ω_{D,δ}` is bijective.

## References

* [Stacks Project, Tag 07HQ](https://stacks.math.columbia.edu/tag/07HQ)
  (divided power differentials)
* [Stacks Project, Tag 07H9](https://stacks.math.columbia.edu/tag/07H9)
  (divided power envelopes)
* [Stacks Project, Tag 07HW](https://stacks.math.columbia.edu/tag/07HW)
  (differentials of a divided power envelope)
-/

open scoped TensorProduct
open scoped Simplicial
open scoped CategoryTheory
open DividedPowers

universe u
/-! ## Divided power Kähler differentials -/

section PDDifferentials

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
variable {J : Ideal B} (δ : DividedPowers J)
variable (M : Type u) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M]

/-- An `A`-linear map `θ : B → M` is a *divided power derivation* if it satisfies the
Leibniz rule and `θ (x^[n]) = x^[n-1] • θ x` for all `n ≥ 1` and `x ∈ J`. -/
structure IsPDDerivation (θ : B →ₗ[A] M) : Prop where
  leibniz : ∀ b b' : B, θ (b * b') = b • θ b' + b' • θ b
  dpow : ∀ (n : ℕ), 1 ≤ n → ∀ x ∈ J, θ (δ.dpow n x) = δ.dpow (n - 1) x • θ x

/-- The `B`-submodule of `Ω[B⁄A]` generated by the elements `d(x^[n]) - x^[n-1] dx`
for `n ≥ 1` and `x ∈ J`. -/
noncomputable def pdRelations : Submodule B (Ω[B⁄A]) :=
  Submodule.span B
    { ω | ∃ (n : ℕ) (_ : 1 ≤ n) (x : B) (_ : x ∈ J),
        ω = KaehlerDifferential.D A B (δ.dpow n x)
              - δ.dpow (n - 1) x • KaehlerDifferential.D A B x }

/-- The module `Ω_{B,δ}` of divided power Kähler differentials of `B` over `A`, the
quotient of `Ω[B⁄A]` by `pdRelations δ`. It is an `abbrev`, so that its module
structures are those of the submodule quotient. -/
abbrev PDKaehler : Type u := Ω[B⁄A] ⧸ pdRelations (A := A) δ

/-- The universal divided power derivation: the Kähler differential `d`
followed by the quotient map. -/
noncomputable def pdD : B →ₗ[A] PDKaehler (A := A) δ :=
  ((pdRelations (A := A) δ).mkQ.restrictScalars A) ∘ₗ
    (KaehlerDifferential.D A B).toLinearMap

@[simp] theorem pdD_apply (b : B) :
    pdD δ b = (pdRelations (A := A) δ).mkQ (KaehlerDifferential.D A B b) := rfl

/-- `pdD` is a divided power derivation. -/
theorem pdD_isPDDerivation :
    IsPDDerivation (A := A) δ (M := PDKaehler (A := A) δ) (pdD δ) where
  leibniz b b' := by
    rw [pdD_apply, pdD_apply, pdD_apply, (KaehlerDifferential.D A B).leibniz,
      map_add, map_smul, map_smul]
  dpow n hn x hx := by
    rw [pdD_apply, pdD_apply, ← map_smul, ← sub_eq_zero, ← map_sub,
      Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact Submodule.subset_span ⟨n, hn, x, hx, rfl⟩

/-- A divided power derivation, regarded as a `Derivation`. The identity `θ 1 = 0`
follows from the Leibniz rule. -/
noncomputable def IsPDDerivation.toDerivation (θ : B →ₗ[A] M) (hθ : IsPDDerivation δ M θ) :
    Derivation A B M where
  toLinearMap := θ
  map_one_eq_zero' := by
    have h := hθ.leibniz 1 1
    simp only [mul_one, one_smul] at h
    have h2 : θ 1 + θ 1 = θ 1 + 0 := by rw [add_zero, ← h]
    exact add_left_cancel h2
  leibniz' := hθ.leibniz

omit [IsScalarTower A B M] in
@[simp] theorem IsPDDerivation.toDerivation_apply (θ : B →ₗ[A] M) (hθ : IsPDDerivation δ M θ)
    (b : B) : hθ.toDerivation δ M θ b = θ b := rfl

/-- The `B`-linear map `Ω_{B,δ} → M` induced by a divided power derivation
`θ : B → M`. It is obtained from the universal property of `Ω[B⁄A]`; the divided
power condition on `θ` ensures that it vanishes on `pdRelations δ`. -/
noncomputable def PDKaehler.lift (θ : B →ₗ[A] M) (hθ : IsPDDerivation δ M θ) :
    PDKaehler (A := A) δ →ₗ[B] M :=
  Submodule.liftQ (pdRelations (A := A) δ)
    (hθ.toDerivation δ M θ).liftKaehlerDifferential (by
      rw [pdRelations, Submodule.span_le]
      rintro ω ⟨n, hn, x, hx, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker, map_sub, map_smul,
        Derivation.liftKaehlerDifferential_comp_D,
        Derivation.liftKaehlerDifferential_comp_D, sub_eq_zero]
      exact hθ.dpow n hn x hx)

/-- Existence part of the universal property: `PDKaehler.lift θ ∘ pdD = θ`. -/
theorem PDKaehler.lift_comp (θ : B →ₗ[A] M) (hθ : IsPDDerivation δ M θ) :
    (PDKaehler.lift δ M θ hθ).restrictScalars A ∘ₗ pdD δ = θ := by
  ext b
  simp only [LinearMap.coe_comp, LinearMap.restrictScalars_apply, Function.comp_apply,
    pdD_apply, PDKaehler.lift, Submodule.mkQ_apply, Submodule.liftQ_apply,
    Derivation.liftKaehlerDifferential_comp_D]
  rfl

/-- Uniqueness part of the universal property: `PDKaehler.lift θ` is the only
`B`-linear map `g : Ω_{B,δ} → M` with `g ∘ pdD = θ`. -/
theorem PDKaehler.lift_unique (θ : B →ₗ[A] M) (hθ : IsPDDerivation δ M θ)
    (g : PDKaehler (A := A) δ →ₗ[B] M)
    (hg : (g.restrictScalars A) ∘ₗ pdD δ = θ) :
    g = PDKaehler.lift δ M θ hθ := by
  apply Submodule.linearMap_qext
  apply LinearMap.ext_on_range (KaehlerDifferential.span_range_derivation A B)
  intro b
  have hg' : g (pdD δ b) = θ b := LinearMap.congr_fun hg b
  have hl' : (PDKaehler.lift δ M θ hθ) (pdD δ b) = θ b :=
    LinearMap.congr_fun (PDKaehler.lift_comp δ M θ hθ) b
  simp only [LinearMap.comp_apply, ← pdD_apply, hg', hl']

omit [Module A M] [IsScalarTower A B M] in
/-- Two `B`-linear maps out of `Ω_{B,δ}` are equal if they agree on the image of `pdD`. -/
theorem PDKaehler.hom_ext {f g : PDKaehler (A := A) δ →ₗ[B] M}
    (h : ∀ b, f (pdD δ b) = g (pdD δ b)) : f = g :=
  Submodule.linearMap_qext _ <|
    LinearMap.ext_on_range (KaehlerDifferential.span_range_derivation A B) h

end PDDifferentials

/-! ## Divided power envelopes and their differentials -/

section Computations

/-- `(D, φ, K, δ)` is a divided power envelope `D_{P,γ}(J)` of the ideal `J ⊆ P`
relative to `(A, I, γ)`. Here `K` is an ideal of `D` containing `J·D + I·D`, `δ` is
a divided power structure on `K` compatible with `γ`, and `(D, φ, K, δ)` is initial
among such data: for every `A`-algebra `D'` with an ideal `K'` containing
`J·D' + I·D'` and divided powers `δ'` on `K'` compatible with `γ`, there is a unique
`A`-algebra map `ψ : D → D'` with `ψ ∘ φ = φ'` which is a morphism of divided power
rings.

The ideal `K` is part of the data: it is the divided power ideal generated by the
images of `J` and `I`, and is in general strictly larger than `J·D + I·D`. For
example, for `A = ℤ/p^N`, `P = A[x]` and `J = (x)`, the envelope is the divided
power polynomial algebra `A⟨x⟩` and `x^[p]` lies in `K` but not in `(x, p)·A⟨x⟩`.
All results below only use this universal property, and not a particular
construction of the envelope. -/
structure IsDPEnvelope {A : Type u} [CommRing A] {I : Ideal A} (γ : DividedPowers I)
    {P : Type u} [CommRing P] [Algebra A P] (J : Ideal P)
    (D : Type u) [CommRing D] [Algebra A D] (φ : P →ₐ[A] D)
    (K : Ideal D) (δ : DividedPowers K) : Prop where
  le : J.map φ.toRingHom ⊔ I.map (algebraMap A D) ≤ K
  compat : IsDPMorphism γ δ (algebraMap A D)
  isInitial : ∀ {D' : Type u} [CommRing D'] [Algebra A D']
      (K' : Ideal D') (φ' : P →ₐ[A] D') (δ' : DividedPowers K'),
      J.map φ'.toRingHom ⊔ I.map (algebraMap A D') ≤ K' →
      IsDPMorphism γ δ' (algebraMap A D') →
      ∃! ψ : D →ₐ[A] D', ψ.comp φ = φ' ∧ IsDPMorphism δ δ' ψ.toRingHom

/-- For `A`-algebra maps `φ : P → D` and `ψ : D → D'`, the image under `ψ` of the
ideal `J D + I D` is `J D' + I D'`. -/
theorem map_sup_map_algebraMap_eq {A P D D' : Type u} [CommRing A] [CommRing P] [CommRing D]
    [CommRing D'] [Algebra A P] [Algebra A D] [Algebra A D'] (I : Ideal A) (J : Ideal P)
    (φ : P →ₐ[A] D) (ψ : D →ₐ[A] D') :
    (J.map φ.toRingHom ⊔ I.map (algebraMap A D)).map ψ.toRingHom =
      J.map (ψ.comp φ).toRingHom ⊔ I.map (algebraMap A D') := by
  rw [Ideal.map_sup, Ideal.map_map, Ideal.map_map]
  congr 2
  exact RingHom.ext fun a ↦ ψ.commutes a

/-- Two `A`-algebra maps out of a divided power envelope `D` which are morphisms of
divided power rings and agree on `P` are equal. In particular, a divided power
endomorphism of `D` over `P` is the identity. -/
theorem IsDPEnvelope.algHom_ext {A : Type u} [CommRing A] {I : Ideal A}
    {γ : DividedPowers I} {P : Type u} [CommRing P] [Algebra A P] {J : Ideal P}
    {D : Type u} [CommRing D] [Algebra A D] {φ : P →ₐ[A] D} {K : Ideal D}
    {δ : DividedPowers K} (hD : IsDPEnvelope γ J D φ K δ)
    {D' : Type u} [CommRing D'] [Algebra A D'] {K' : Ideal D'} {δ' : DividedPowers K'}
    {ψ₁ ψ₂ : D →ₐ[A] D'} (h₁ : IsDPMorphism δ δ' ψ₁.toRingHom)
    (h₂ : IsDPMorphism δ δ' ψ₂.toRingHom) (h : ψ₁.comp φ = ψ₂.comp φ) : ψ₁ = ψ₂ := by
  have hcompat : IsDPMorphism γ δ' (algebraMap A D') := by
    convert IsDPMorphism.comp δ' h₁ hD.compat using 1
    exact (ψ₁.comp_algebraMap).symm
  have hle : J.map (ψ₁.comp φ).toRingHom ⊔ I.map (algebraMap A D') ≤ K' := by
    rw [← map_sup_map_algebraMap_eq]
    exact (Ideal.map_mono hD.le).trans h₁.ideal_comp
  exact (hD.isInitial K' _ δ' hle hcompat).unique ⟨rfl, h₁⟩ ⟨h.symm, h₂⟩

/-- A divided power envelope `D_{P,γ}(J)` together with all of its data. The ring
and algebra structures are fields, so that different choices do not give rise to
conflicting global instances. -/
structure DPEnvelopeChoice {A : Type u} [CommRing A] {I : Ideal A}
    (γ : DividedPowers I) {P : Type u} [CommRing P] [Algebra A P]
    (J : Ideal P) where
  carrier : Type u
  commRing : CommRing carrier
  algebra : Algebra A carrier
  map : @AlgHom A P carrier _ _ commRing.toSemiring _ algebra
  pdIdeal : @Ideal carrier commRing.toSemiring
  dividedPowers : @DividedPowers carrier commRing.toCommSemiring pdIdeal
  isEnvelope : @IsDPEnvelope A _ I γ P _ _ J carrier commRing algebra
    map pdIdeal dividedPowers

/-- The existence of a divided power envelope `D_{P,γ}(J)`, as a proposition.
It holds for every ideal `J` (`AffineCrystalline.DPEnvelope.hasDPEnvelope`). -/
class HasDPEnvelope {A : Type u} [CommRing A] {I : Ideal A}
    (γ : DividedPowers I) {P : Type u} [CommRing P] [Algebra A P]
    (J : Ideal P) : Prop where
  exists_envelope : Nonempty (DPEnvelopeChoice γ J)

/-- A divided power envelope, chosen using `HasDPEnvelope`. -/
noncomputable def chosenDPEnvelope {A : Type u} [CommRing A] {I : Ideal A}
    (γ : DividedPowers I) {P : Type u} [CommRing P] [Algebra A P]
    (J : Ideal P) [HasDPEnvelope γ J] : DPEnvelopeChoice γ J :=
  Classical.choice HasDPEnvelope.exists_envelope

/-- The underlying type of the chosen envelope. -/
abbrev chosenDPEnvelopeCarrier {A : Type u} [CommRing A] {I : Ideal A}
    (γ : DividedPowers I) {P : Type u} [CommRing P] [Algebra A P]
    (J : Ideal P) [HasDPEnvelope γ J] : Type u :=
  (chosenDPEnvelope γ J).carrier

/-- The chosen envelope satisfies its defining universal property. -/
theorem chosenDPEnvelope_isDPEnvelope {A : Type u} [CommRing A] {I : Ideal A}
    (γ : DividedPowers I) {P : Type u} [CommRing P] [Algebra A P]
    (J : Ideal P) [HasDPEnvelope γ J] :
    @IsDPEnvelope A _ I γ P _ _ J
      (chosenDPEnvelope γ J).carrier
      (chosenDPEnvelope γ J).commRing
      (chosenDPEnvelope γ J).algebra
      (chosenDPEnvelope γ J).map
      (chosenDPEnvelope γ J).pdIdeal
      (chosenDPEnvelope γ J).dividedPowers :=
  (chosenDPEnvelope γ J).isEnvelope

/-- The divided power envelope `D_{P,γ}(J)`, assuming `HasDPEnvelope γ J`. -/
def dpEnvelope {A : Type u} [CommRing A] {I : Ideal A} (γ : DividedPowers I)
    {P : Type u} [CommRing P] [Algebra A P] (J : Ideal P)
    [HasDPEnvelope γ J] : Type u :=
  chosenDPEnvelopeCarrier γ J

noncomputable instance dpEnvelope.instCommRing {A : Type u} [CommRing A] {I : Ideal A}
    (γ : DividedPowers I) {P : Type u} [CommRing P] [Algebra A P] (J : Ideal P)
    [HasDPEnvelope γ J] : CommRing (dpEnvelope γ J) :=
  (chosenDPEnvelope γ J).commRing

noncomputable instance dpEnvelope.instAlgebra {A : Type u} [CommRing A] {I : Ideal A}
    (γ : DividedPowers I) {P : Type u} [CommRing P] [Algebra A P] (J : Ideal P)
    [HasDPEnvelope γ J] : Algebra A (dpEnvelope γ J) :=
  (chosenDPEnvelope γ J).algebra

/-- The structure map `P → D_{P,γ}(J)`. -/
noncomputable def dpEnvelope.map {A : Type u} [CommRing A] {I : Ideal A}
    (γ : DividedPowers I) {P : Type u} [CommRing P] [Algebra A P] (J : Ideal P)
    [HasDPEnvelope γ J] : P →ₐ[A] dpEnvelope γ J :=
  (chosenDPEnvelope γ J).map

/-- The divided power ideal of `D = D_{P,γ}(J)`; it contains `J·D + I·D`. -/
noncomputable def dpEnvelope.pdIdeal {A : Type u} [CommRing A] {I : Ideal A}
    (γ : DividedPowers I) {P : Type u} [CommRing P] [Algebra A P] (J : Ideal P)
    [HasDPEnvelope γ J] : Ideal (dpEnvelope γ J) :=
  (chosenDPEnvelope γ J).pdIdeal

/-- The divided powers on the divided power ideal of `D = D_{P,γ}(J)`. -/
noncomputable def dpEnvelope.dividedPowers {A : Type u} [CommRing A] {I : Ideal A}
    (γ : DividedPowers I) {P : Type u} [CommRing P] [Algebra A P] (J : Ideal P)
    [HasDPEnvelope γ J] :
    DividedPowers (dpEnvelope.pdIdeal γ J) :=
  (chosenDPEnvelope γ J).dividedPowers

/-- `dpEnvelope γ J` satisfies the universal property `IsDPEnvelope`. -/
theorem dpEnvelope_isDPEnvelope {A : Type u} [CommRing A] {I : Ideal A}
    (γ : DividedPowers I) {P : Type u} [CommRing P] [Algebra A P] (J : Ideal P)
    [HasDPEnvelope γ J] :
    IsDPEnvelope γ J (dpEnvelope γ J) (dpEnvelope.map γ J) (dpEnvelope.pdIdeal γ J)
      (dpEnvelope.dividedPowers γ J) :=
  (chosenDPEnvelope γ J).isEnvelope

/-- The canonical `D`-linear map `D ⊗_B Ω[B⁄A] → Ω_{D,δ}`, `d ⊗ db ↦ d • dφ(b)`:
the base change map `D ⊗_B Ω[B⁄A] → Ω[D⁄A]` followed by the quotient map onto
`Ω_{D,δ}`. It is defined for any `B`-algebra `D` with divided powers; when `D` is
a divided power envelope it is bijective (`pdKaehler_dpEnvelope`). -/
noncomputable def pdKaehlerDpEnvelopeComparison
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {D : Type u} [CommRing D] [Algebra A D] [Algebra B D] [IsScalarTower A B D]
    {J_D : Ideal D} (δ : DividedPowers J_D) :
    (D ⊗[B] Ω[B⁄A]) →ₗ[D] PDKaehler (A := A) δ :=
  (pdRelations (A := A) δ).mkQ ∘ₗ KaehlerDifferential.mapBaseChange A B D

/-! ### Derivations as maps to square-zero extensions -/

/-- The `A`-algebra map `B → D ⊕ M`, `b ↦ (b, v b)`, into the trivial square-zero
extension associated to an `A`-derivation `v : B → M`. -/
noncomputable def derivationGraph
    {A B D M : Type u} [CommRing A] [CommRing B] [CommRing D]
    [Algebra A B] [Algebra A D] [Algebra B D] [IsScalarTower A B D]
    [AddCommGroup M] [Module D M] [Module B M] [Module A M]
    [IsScalarTower A D M] [IsScalarTower B D M]
    [Module Dᵐᵒᵖ M] [IsCentralScalar D M]
    (v : Derivation A B M) : B →ₐ[A] TrivSqZeroExt D M where
  toFun b := TrivSqZeroExt.inl (algebraMap B D b) + TrivSqZeroExt.inr (v b)
  map_one' := by simp
  map_mul' b b' := by
    apply TrivSqZeroExt.ext
    · simp
    · simp [v.leibniz, IsScalarTower.algebraMap_smul D]
  map_zero' := by simp
  map_add' b b' := by apply TrivSqZeroExt.ext <;> simp
  commutes' a := by
    rw [TrivSqZeroExt.algebraMap_eq_inl']
    apply TrivSqZeroExt.ext
    · simp [← IsScalarTower.algebraMap_apply A B D]
    · simp

@[simp] theorem derivationGraph_fst
    {A B D M : Type u} [CommRing A] [CommRing B] [CommRing D]
    [Algebra A B] [Algebra A D] [Algebra B D] [IsScalarTower A B D]
    [AddCommGroup M] [Module D M] [Module B M] [Module A M]
    [IsScalarTower A D M] [IsScalarTower B D M]
    [Module Dᵐᵒᵖ M] [IsCentralScalar D M]
    (v : Derivation A B M) (b : B) :
    (derivationGraph (D := D) v b).fst = algebraMap B D b := by
  simp [derivationGraph]

@[simp] theorem derivationGraph_snd
    {A B D M : Type u} [CommRing A] [CommRing B] [CommRing D]
    [Algebra A B] [Algebra A D] [Algebra B D] [IsScalarTower A B D]
    [AddCommGroup M] [Module D M] [Module B M] [Module A M]
    [IsScalarTower A D M] [IsScalarTower B D M]
    [Module Dᵐᵒᵖ M] [IsCentralScalar D M]
    (v : Derivation A B M) (b : B) :
    (derivationGraph (D := D) v b).snd = v b := by
  simp [derivationGraph]

/-- The projection `D ⊕ M → D` from the square-zero extension, with its divided
powers `sqZeroDividedPowers δ M`, is a morphism of divided power rings. -/
theorem sqZero_fst_isDPMorphism
    {A D M : Type u} [CommRing A] [CommRing D] [Algebra A D]
    [AddCommGroup M] [Module D M] [Module A M] [IsScalarTower A D M]
    [Module Dᵐᵒᵖ M] [IsCentralScalar D M]
    {K : Ideal D} (δ : DividedPowers K) :
    IsDPMorphism (sqZeroDividedPowers δ M) δ
      (TrivSqZeroExt.fstHom A D M).toRingHom where
  ideal_comp := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    simpa [Ideal.mem_comap] using (mem_sqZeroIdeal K M x).mp hx
  dpow_comp {n} x hx := by
    change δ.dpow n x.fst = (sqZeroDpow δ M n x).fst
    rw [sqZeroDpow_fst]

/-- If `θ : D → M` is a divided power derivation, then `d ↦ (d, θ d)` is a morphism
of divided power rings `D → D ⊕ M`. -/
theorem pdDerivationGraph_isDPMorphism
    {A D M : Type u} [CommRing A] [CommRing D] [Algebra A D]
    [AddCommGroup M] [Module D M] [Module A M] [IsScalarTower A D M]
    [Module Dᵐᵒᵖ M] [IsCentralScalar D M]
    {K : Ideal D} (δ : DividedPowers K)
    (θ : D →ₗ[A] M) (hθ : IsPDDerivation δ M θ) :
    IsDPMorphism δ (sqZeroDividedPowers δ M)
      (derivationGraph (D := D) (hθ.toDerivation δ M θ)).toRingHom := by
  rw [isDPMorphism_iff]
  refine ⟨Ideal.map_le_iff_le_comap.2 fun x hx ↦ ?_, fun n hn x hx ↦ ?_⟩
  · rw [Ideal.mem_comap, mem_sqZeroIdeal]
    simpa using hx
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hn
  apply TrivSqZeroExt.ext
  · simp [sqZeroDividedPowers]
  · change (sqZeroDpow δ M (n + 1) _).snd = _
    rw [sqZeroDpow_snd_succ]
    simpa using (hθ.dpow (n + 1) (Nat.le_add_left 1 n) x hx).symm

/-- The composition of a divided power derivation with a `D`-linear map is a
divided power derivation. -/
theorem IsPDDerivation.compLinearMap
    {A D M N : Type u} [CommRing A] [CommRing D] [Algebra A D]
    [AddCommGroup M] [Module D M] [Module A M] [IsScalarTower A D M]
    [AddCommGroup N] [Module D N] [Module A N] [IsScalarTower A D N]
    {K : Ideal D} (δ : DividedPowers K) (θ : D →ₗ[A] M)
    (hθ : IsPDDerivation δ M θ) (f : M →ₗ[D] N) :
    IsPDDerivation δ N ((f.restrictScalars A) ∘ₗ θ) where
  leibniz d d' := by
    change f (θ (d * d')) = d • f (θ d') + d' • f (θ d)
    rw [hθ.leibniz, map_add, f.map_smul, f.map_smul]
  dpow n hn d hd := by
    change f (θ (δ.dpow n d)) = δ.dpow (n - 1) d • f (θ d)
    rw [hθ.dpow n hn d hd, f.map_smul]

@[simp] theorem pdKaehlerDpEnvelopeComparison_tmul_D
    {A B D : Type u} [CommRing A] [CommRing B] [CommRing D]
    [Algebra A B] [Algebra A D] [Algebra B D] [IsScalarTower A B D]
    {K : Ideal D} (δ : DividedPowers K) (d : D) (b : B) :
    pdKaehlerDpEnvelopeComparison (A := A) (B := B) δ
        (d ⊗ₜ[B] KaehlerDifferential.D A B b) =
      d • pdD δ (algebraMap B D b) := by
  simp [pdKaehlerDpEnvelopeComparison, pdD_apply,
    KaehlerDifferential.mapBaseChange_tmul, KaehlerDifferential.map_D]

/-- Two `D`-linear maps out of `D ⊗_B Ω[B⁄A]` are equal if they agree on the elements
`1 ⊗ db` for `b ∈ B`. -/
theorem tensorKaehler_linearMap_ext
    {A B D N : Type u} [CommRing A] [CommRing B] [CommRing D] [Algebra A B] [Algebra B D]
    [AddCommGroup N] [Module D N] [Module B N] [IsScalarTower B D N]
    {f g : D ⊗[B] Ω[B⁄A] →ₗ[D] N}
    (h : ∀ b : B, f (1 ⊗ₜ KaehlerDifferential.D A B b) = g (1 ⊗ₜ KaehlerDifferential.D A B b)) :
    f = g := by
  have h₁ : (f.restrictScalars B) ∘ₗ TensorProduct.mk B D Ω[B⁄A] 1 =
      (g.restrictScalars B) ∘ₗ TensorProduct.mk B D Ω[B⁄A] 1 :=
    LinearMap.ext_on_range (KaehlerDifferential.span_range_derivation A B) h
  refine TensorProduct.AlgebraTensorModule.ext fun d ω ↦ ?_
  rw [← mul_one d, ← smul_eq_mul, ← TensorProduct.smul_tmul', map_smul, map_smul]
  exact congrArg (d • ·) (LinearMap.congr_fun h₁ ω)

@[simp] theorem fstHom_comp_derivationGraph
    {A B D M : Type u} [CommRing A] [CommRing B] [CommRing D]
    [Algebra A B] [Algebra A D] [Algebra B D] [IsScalarTower A B D]
    [AddCommGroup M] [Module D M] [Module B M] [Module A M]
    [IsScalarTower A D M] [IsScalarTower B D M]
    [Module Dᵐᵒᵖ M] [IsCentralScalar D M]
    (v : Derivation A B M) :
    (TrivSqZeroExt.fstHom A D M).comp (derivationGraph (D := D) v) =
      IsScalarTower.toAlgHom A B D := by
  ext b
  simp

/-- Let `φ' : P → D ⊕ M` be an `A`-algebra map lifting `φ : P → D` to the square-zero
extension. If `φ` sends `J` and `I` into `K`, then `φ'` sends `J` and `I` into the
ideal `K ⊕ M` of `D ⊕ M`. -/
theorem map_sup_map_le_sqZeroIdeal {A P D M : Type u} [CommRing A] [CommRing P]
    [CommRing D] [Algebra A P] [Algebra A D] [AddCommGroup M] [Module D M] [Module A M]
    [IsScalarTower A D M] [Module Dᵐᵒᵖ M] [IsCentralScalar D M] {I : Ideal A}
    {φ : P →ₐ[A] D} {J : Ideal P} {K : Ideal D}
    (hle : J.map φ.toRingHom ⊔ I.map (algebraMap A D) ≤ K)
    (φ' : P →ₐ[A] TrivSqZeroExt D M) (hφ' : (TrivSqZeroExt.fstHom A D M).comp φ' = φ) :
    J.map φ'.toRingHom ⊔ I.map (algebraMap A (TrivSqZeroExt D M)) ≤ sqZeroIdeal K M := by
  rw [sup_le_iff, Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
  constructor
  · intro j hj
    rw [Ideal.mem_comap, mem_sqZeroIdeal]
    have hj' := hle (Ideal.mem_sup_left (Ideal.mem_map_of_mem φ.toRingHom hj))
    rwa [← hφ'] at hj'
  · intro i hi
    rw [Ideal.mem_comap, mem_sqZeroIdeal, TrivSqZeroExt.algebraMap_eq_inl']
    simpa using hle (Ideal.mem_sup_right (Ideal.mem_map_of_mem (algebraMap A D) hi))

/-- If the structure map `A → D` is a divided power morphism, then so is the
structure map `A → D ⊕ M` into the square-zero extension. -/
theorem isDPMorphism_algebraMap_trivSqZeroExt
    {A D M : Type u} [CommRing A] [CommRing D] [Algebra A D]
    [AddCommGroup M] [Module D M] [Module A M] [IsScalarTower A D M]
    [Module Dᵐᵒᵖ M] [IsCentralScalar D M]
    {I : Ideal A} {γ : DividedPowers I} {K : Ideal D} {δ : DividedPowers K}
    (h : IsDPMorphism γ δ (algebraMap A D)) :
    IsDPMorphism γ (sqZeroDividedPowers δ M) (algebraMap A (TrivSqZeroExt D M)) := by
  convert IsDPMorphism.comp (sqZeroDividedPowers δ M) (sqZero_isDPMorphism δ M) h using 1
  exact RingHom.ext fun a ↦ TrivSqZeroExt.algebraMap_eq_inl' A D M a

/-- Let `ψ : D → D ⊕ M` be an `A`-algebra map which is a morphism of divided power
rings and whose first component is the identity. Then its second component
`D → M` is a divided power derivation. -/
theorem isPDDerivation_sndHom_comp
    {A D M : Type u} [CommRing A] [CommRing D] [Algebra A D]
    [AddCommGroup M] [Module D M] [Module A M] [IsScalarTower A D M]
    [Module Dᵐᵒᵖ M] [IsCentralScalar D M]
    {K : Ideal D} {δ : DividedPowers K} {ψ : D →ₐ[A] TrivSqZeroExt D M}
    (hψ : IsDPMorphism δ (sqZeroDividedPowers δ M) ψ.toRingHom)
    (hfst : (TrivSqZeroExt.fstHom A D M).comp ψ = AlgHom.id A D) :
    IsPDDerivation δ M ((TrivSqZeroExt.sndHom D M).restrictScalars A ∘ₗ ψ.toLinearMap) := by
  have hψfst (d : D) : (ψ d).fst = d := AlgHom.congr_fun hfst d
  constructor
  · intro d d'
    change (ψ (d * d')).snd = d • (ψ d').snd + d' • (ψ d).snd
    rw [map_mul, TrivSqZeroExt.snd_mul, hψfst, hψfst, op_smul_eq_smul]
  · intro n hn d hd
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero (Nat.one_le_iff_ne_zero.1 hn)
    have hdp := congrArg TrivSqZeroExt.snd (hψ.dpow_comp (n := k + 1) d hd)
    change (sqZeroDpow δ M (k + 1) (ψ d)).snd = (ψ (δ.dpow (k + 1) d)).snd at hdp
    rw [sqZeroDpow_snd_succ, hψfst] at hdp
    exact hdp.symm

/-- Two divided power derivations out of a divided power envelope `D` of `(P, J)`
which agree on the image of `P` are equal. -/
theorem IsDPEnvelope.pdDerivation_ext {A P D M : Type u} [CommRing A] [CommRing P]
    [CommRing D] [Algebra A P] [Algebra A D] [AddCommGroup M] [Module D M] [Module A M]
    [IsScalarTower A D M] {I : Ideal A} {γ : DividedPowers I} {φ : P →ₐ[A] D}
    {J : Ideal P} {K : Ideal D} {δ : DividedPowers K} (hD : IsDPEnvelope γ J D φ K δ)
    {θ₁ θ₂ : D →ₗ[A] M} (hθ₁ : IsPDDerivation δ M θ₁) (hθ₂ : IsPDDerivation δ M θ₂)
    (h : θ₁.comp φ.toLinearMap = θ₂.comp φ.toLinearMap) : θ₁ = θ₂ := by
  letI : Module Dᵐᵒᵖ M :=
    Module.compHom M ((RingEquiv.toOpposite D).symm : Dᵐᵒᵖ ≃+* D).toRingHom
  haveI : IsCentralScalar D M := ⟨fun _ _ ↦ rfl⟩
  have heq := hD.algHom_ext (pdDerivationGraph_isDPMorphism δ θ₁ hθ₁)
    (pdDerivationGraph_isDPMorphism δ θ₂ hθ₂) <| by
      ext p
      · simp
      · simpa using LinearMap.congr_fun h p
  ext d
  simpa using congrArg TrivSqZeroExt.snd (AlgHom.congr_fun heq d)

/-- Let `D` be a divided power envelope of `(B, J)`. Every `A`-derivation
`v : B → M` with values in a `D`-module extends uniquely to a divided power
derivation `θ : D → M`.

The extension is obtained by applying the universal property of `D` to the
graph `b ↦ (b, v b)` with values in the square-zero extension `D ⊕ M`: this gives
a divided power morphism `ψ : D → D ⊕ M`, whose first component is the identity by
`IsDPEnvelope.algHom_ext`, and `θ` is its second component. Uniqueness is
`IsDPEnvelope.pdDerivation_ext`. -/
theorem existsUnique_pdDerivation_extension
    {A B D M : Type u} [CommRing A] [CommRing B] [CommRing D]
    [Algebra A B] [Algebra A D] [Algebra B D] [IsScalarTower A B D]
    [AddCommGroup M] [Module D M] [Module B M] [Module A M]
    [IsScalarTower A D M] [IsScalarTower B D M]
    [Module Dᵐᵒᵖ M] [IsCentralScalar D M]
    {I : Ideal A} {J : Ideal B} {γ : DividedPowers I}
    {K_D : Ideal D} {δ : DividedPowers K_D}
    (hD : IsDPEnvelope γ J D (IsScalarTower.toAlgHom A B D) K_D δ)
    (v : Derivation A B M) :
    ∃! θ : D →ₗ[A] M,
      IsPDDerivation δ M θ ∧
        θ.comp (IsScalarTower.toAlgHom A B D).toLinearMap = v.toLinearMap := by
  obtain ⟨ψ, hψ, -⟩ := hD.isInitial (sqZeroIdeal K_D M) (derivationGraph (D := D) v)
    (sqZeroDividedPowers δ M)
    (map_sup_map_le_sqZeroIdeal hD.le _ (fstHom_comp_derivationGraph v))
    (isDPMorphism_algebraMap_trivSqZeroExt hD.compat)
  have hfst : (TrivSqZeroExt.fstHom A D M).comp ψ = AlgHom.id A D := by
    refine hD.algHom_ext ?_ (DPMorphism.id δ).isDPMorphism ?_
    · simpa [AlgHom.comp_toRingHom] using
        IsDPMorphism.comp δ (sqZero_fst_isDPMorphism (M := M) δ) hψ.2
    · rw [AlgHom.comp_assoc, hψ.1, fstHom_comp_derivationGraph, AlgHom.id_comp]
  have hθ := isPDDerivation_sndHom_comp hψ.2 hfst
  have hθv : ((TrivSqZeroExt.sndHom D M).restrictScalars A ∘ₗ ψ.toLinearMap).comp
      (IsScalarTower.toAlgHom A B D).toLinearMap = v.toLinearMap := by
    ext b
    simpa using congrArg TrivSqZeroExt.snd (AlgHom.congr_fun hψ.1 b)
  exact ⟨_, ⟨hθ, hθv⟩, fun θ hθ' ↦ hD.pdDerivation_ext hθ'.1 hθ (hθ'.2.trans hθv.symm)⟩

/-- **Differentials of a divided power envelope.** Let `D` be a divided power
envelope of `(B, J)` relative to `(A, I, γ)`, with divided powers `δ`. Then the
canonical map `D ⊗_B Ω[B⁄A] → Ω_{D,δ}` is bijective; note that the left-hand side
involves the *ordinary* Kähler differentials of `B`. The statement holds for any
triple satisfying `IsDPEnvelope`.

*Proof.* For a `D`-module `M`, `A`-derivations `B → M` correspond bijectively to
divided power derivations `D → M` (`existsUnique_pdDerivation_extension`).
Hence both sides corepresent the same functor on `D`-modules, and one checks that
the inverse constructed from `PDKaehler.lift` is a two-sided inverse of the
comparison map. See [Stacks, Tag 07HW]. -/
theorem pdKaehler_dpEnvelope {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {I : Ideal A} {γ : DividedPowers I} {J : Ideal B} {D : Type u} [CommRing D]
    [Algebra A D] [Algebra B D] [IsScalarTower A B D]
    {K_D : Ideal D} {δ : DividedPowers K_D}
    (hD : IsDPEnvelope γ J D (IsScalarTower.toAlgHom A B D) K_D δ) :
    Function.Bijective (pdKaehlerDpEnvelopeComparison (A := A) (B := B) δ) := by
  set cmp := pdKaehlerDpEnvelopeComparison (A := A) (B := B) δ
  let v : Derivation A B (D ⊗[B] Ω[B⁄A]) :=
    ((TensorProduct.mk B D Ω[B⁄A]) 1).compDer (KaehlerDifferential.D A B)
  obtain ⟨θ, ⟨hθ, hθv⟩, -⟩ := existsUnique_pdDerivation_extension hD v
  have hθb (b : B) : θ (algebraMap B D b) = 1 ⊗ₜ KaehlerDifferential.D A B b :=
    LinearMap.congr_fun hθv b
  set inv := PDKaehler.lift δ _ θ hθ
  have hinv (d : D) : inv (pdD δ d) = θ d := LinearMap.congr_fun (PDKaehler.lift_comp δ _ θ hθ) d
  letI : Module Dᵐᵒᵖ (PDKaehler (A := A) δ) :=
    Module.compHom _ ((RingHom.id D).fromOpposite mul_comm)
  haveI : IsCentralScalar D (PDKaehler (A := A) δ) := ⟨fun _ _ ↦ rfl⟩
  -- `cmp ∘ θ` and `pdD` are divided power derivations extending the same derivation of `B`.
  have hcmpθ : (cmp.restrictScalars A) ∘ₗ θ = pdD δ :=
    (existsUnique_pdDerivation_extension hD
      (((pdD_isPDDerivation δ).toDerivation δ _ (pdD δ)).compAlgebraMap B)).unique
      ⟨hθ.compLinearMap δ θ cmp, LinearMap.ext fun b ↦ by simp [cmp, hθb]⟩
      ⟨pdD_isPDDerivation δ, rfl⟩
  have hleft : inv.comp cmp = LinearMap.id :=
    tensorKaehler_linearMap_ext fun b ↦ by
      simp only [cmp, LinearMap.comp_apply, pdKaehlerDpEnvelopeComparison_tmul_D, one_smul, hinv,
        hθb, LinearMap.id_apply]
  have hright : cmp.comp inv = LinearMap.id :=
    PDKaehler.hom_ext δ _ fun d ↦ by
      rw [LinearMap.comp_apply, hinv, LinearMap.id_apply]
      exact LinearMap.congr_fun hcmpθ d
  exact Function.bijective_iff_has_inverse.2
    ⟨inv, LinearMap.congr_fun hleft, LinearMap.congr_fun hright⟩
end Computations
