import AffineCrystalline.DeRham.Construction.ExteriorSquareZero

/-!
# Degree-one PD relations in the exterior algebra

The quotient map `Ω[B⁄A] → Ω_{B,δ}` induces a map of exterior algebras
`⋀_B Ω[B⁄A] → ⋀_B Ω_{B,δ}`. This map kills the `B`-submodule generated by the
degree-one images of the elements of `pdRelations δ`, and therefore factors
through the quotient of `⋀_B Ω[B⁄A]` by this submodule. The quotient is taken as
a quotient of `B`-modules.

## Main definitions

* `pdExteriorMap δ`: the map `⋀_B Ω[B⁄A] → ⋀_B Ω_{B,δ}` induced by the quotient map.
* `relationExteriorSubmodule δ`: the `B`-submodule of `⋀_B Ω[B⁄A]` spanned by the
  elements of `pdRelations δ`, viewed in degree one.
* `RelationExteriorQuotient δ`: the corresponding quotient module.
* `relationExteriorQuotientLift δ`: the induced map
  `RelationExteriorQuotient δ → ⋀_B Ω_{B,δ}`.

## Main results

* `relationExteriorSubmodule_le_ker`: `relationExteriorSubmodule δ` is contained in
  the kernel of `pdExteriorMap δ`.
-/

open DividedPowers

universe u

namespace AffineCrystalline.DeRham.Construction

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
variable {J : Ideal B} (δ : DividedPowers J)

/-- The map of exterior algebras `⋀_B Ω[B⁄A] → ⋀_B Ω_{B,δ}` induced by the quotient
map `Ω[B⁄A] → Ω_{B,δ}`. -/
noncomputable def pdExteriorMap :
    ExteriorAlgebra B (Ω[B⁄A]) →ₐ[B] PDExterior (A := A) δ :=
  ExteriorAlgebra.map ((pdRelations (A := A) δ).mkQ)

/-- The `B`-submodule of `⋀_B Ω[B⁄A]` spanned by the elements of `pdRelations δ`,
viewed in degree one. -/
noncomputable def relationExteriorSubmodule :
    Submodule B (ExteriorAlgebra B (Ω[B⁄A])) :=
  Submodule.span B
    (ExteriorAlgebra.ι B '' (pdRelations (A := A) δ : Set (Ω[B⁄A]))
      : Set (ExteriorAlgebra B (Ω[B⁄A])))

/-- `pdExteriorMap δ` kills the degree-one image of every element of
`pdRelations δ`. -/
theorem pdExteriorMap_relation_generator_eq_zero
    {ω : Ω[B⁄A]} (hω : ω ∈ pdRelations (A := A) δ) :
    pdExteriorMap δ (ExteriorAlgebra.ι B ω) = 0 := by
  rw [pdExteriorMap, ExteriorAlgebra.map_apply_ι]
  have hmk :
      (pdRelations (A := A) δ).mkQ ω = 0 := by
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact hω
  rw [hmk, map_zero]

/-- `relationExteriorSubmodule δ` is contained in the kernel of `pdExteriorMap δ`. -/
theorem relationExteriorSubmodule_le_ker :
    relationExteriorSubmodule δ ≤
      LinearMap.ker
        ((pdExteriorMap δ).toLinearMap :
          ExteriorAlgebra B (Ω[B⁄A]) →ₗ[B] PDExterior (A := A) δ) := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨ω, hω, rfl⟩
  exact pdExteriorMap_relation_generator_eq_zero δ hω

/-- The quotient of `⋀_B Ω[B⁄A]`, as a `B`-module, by `relationExteriorSubmodule δ`. -/
abbrev RelationExteriorQuotient :=
  (ExteriorAlgebra B (Ω[B⁄A])) ⧸ relationExteriorSubmodule δ

/-- The `B`-linear map `RelationExteriorQuotient δ → ⋀_B Ω_{B,δ}` induced by
`pdExteriorMap δ`. -/
noncomputable def relationExteriorQuotientLift :
    RelationExteriorQuotient (A := A) (B := B) δ →ₗ[B]
      PDExterior (A := A) (B := B) δ :=
  Submodule.liftQ (relationExteriorSubmodule (A := A) (B := B) δ)
    ((pdExteriorMap δ).toLinearMap :
      ExteriorAlgebra B (Ω[B⁄A]) →ₗ[B] PDExterior (A := A) (B := B) δ) <| by
    intro ω hω
    exact relationExteriorSubmodule_le_ker δ hω

@[simp]
theorem relationExteriorQuotientLift_mk (ω : ExteriorAlgebra B (Ω[B⁄A])) :
    relationExteriorQuotientLift (A := A) (B := B) δ
        ((relationExteriorSubmodule (A := A) (B := B) δ).mkQ ω) =
      pdExteriorMap δ ω := by
  rfl

@[simp]
theorem relationExteriorQuotientLift_pdRelationGenerator
    (n : ℕ) (hn : 1 ≤ n) (x : B) (hx : x ∈ J) :
    relationExteriorQuotientLift (A := A) (B := B) δ
        ((relationExteriorSubmodule (A := A) (B := B) δ).mkQ
          (ExteriorAlgebra.ι B (pdRelationGenerator (A := A) (B := B) δ n x))) = 0 := by
  rw [relationExteriorQuotientLift_mk,
    pdExteriorMap_relation_generator_eq_zero (A := A) (B := B) δ
      (pdRelationGenerator_mem (A := A) (B := B) δ n hn x hx)]

end AffineCrystalline.DeRham.Construction
