import Mathlib.LinearAlgebra.ExteriorAlgebra.Basic
import AffineCrystalline.PDDifferentials

/-!
# The defining relations of the module of PD differentials

Let `δ` be a divided-power structure on an ideal `J ⊆ B`. The module
`PDKaehler δ` of divided-power differentials is the quotient of `Ω[B⁄A]` by the
`B`-submodule `pdRelations δ` generated by the one-forms
`d (δ.dpow n x) - δ.dpow (n - 1) x • d x` for `n ≥ 1` and `x ∈ J`
(Stacks Project, Tag 07HQ). This file names these generators and records that
they vanish in the quotient.

## Main definitions

* `pdRelationGenerator δ n x`: the one-form `d (δ.dpow n x) - δ.dpow (n - 1) x • d x`.

## Main results

* `pdRelationGenerator_mem`: each generator lies in `pdRelations δ`.
* `mkQ_pdRelationGenerator_eq_zero`: each generator maps to zero in `PDKaehler δ`.
* `pdRelationGenerator_exterior_square_zero`: the square of its image in the
  exterior algebra of `PDKaehler δ` vanishes.

## References

* [Stacks Project, Tag 07HQ](https://stacks.math.columbia.edu/tag/07HQ)
-/

open scoped TensorProduct
open DividedPowers

universe u

namespace AffineCrystalline.DeRham

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
variable {J : Ideal B} (δ : DividedPowers J)

/-- The one-form `d (δ.dpow n x) - δ.dpow (n - 1) x • d x`; for `n ≥ 1` and
`x ∈ J`, these generate the relations defining `PDKaehler δ`. -/
noncomputable def pdRelationGenerator (n : ℕ) (x : B) : Ω[B⁄A] :=
  KaehlerDifferential.D A B (δ.dpow n x) -
    δ.dpow (n - 1) x • KaehlerDifferential.D A B x

/-- Every defining PD relation lies in `pdRelations δ`. -/
theorem pdRelationGenerator_mem (n : ℕ) (hn : 1 ≤ n) (x : B) (hx : x ∈ J) :
    pdRelationGenerator δ n x ∈ pdRelations (A := A) δ :=
  Submodule.subset_span ⟨n, hn, x, hx, rfl⟩

/-- Every defining PD relation maps to zero in `PDKaehler δ`. -/
theorem mkQ_pdRelationGenerator_eq_zero (n : ℕ) (hn : 1 ≤ n) (x : B) (hx : x ∈ J) :
    (pdRelations (A := A) δ).mkQ (pdRelationGenerator δ n x) = 0 := by
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  exact pdRelationGenerator_mem δ n hn x hx

/-- The image of a defining PD relation in the exterior algebra of
`PDKaehler δ` over `B` has square zero (indeed, the image itself is zero). -/
theorem pdRelationGenerator_exterior_square_zero
    (n : ℕ) (hn : 1 ≤ n) (x : B) (hx : x ∈ J) :
    ExteriorAlgebra.ι B ((pdRelations (A := A) δ).mkQ (pdRelationGenerator δ n x)) *
        ExteriorAlgebra.ι B ((pdRelations (A := A) δ).mkQ (pdRelationGenerator δ n x)) = 0 := by
  rw [mkQ_pdRelationGenerator_eq_zero δ n hn x hx]
  exact ExteriorAlgebra.ι_sq_zero 0

end AffineCrystalline.DeRham
