import Mathlib.Data.Rel
import Mathlib.RingTheory.DividedPowerAlgebra.Init
import Mathlib.RingTheory.DividedPowers.Basic

/-!
# The relation ideal of the divided power envelope

Let `(A, I, γ)` be a divided power ring, `B` an `A`-algebra and `J ⊆ B` an ideal
with `I B ⊆ J`. Following Berthelot–Ogus, the divided power envelope of `(B, J)`
is constructed as a quotient of the divided power algebra `Γ_B(J)` of the
`B`-module `J` by the ideal `J₁₂ = J₁ + J₂`, where

* `J₁` is generated by the elements `[1](x) - x` for `x ∈ J`, identifying the
  degree one generator attached to `x` with `x ∈ B`;
* `J₂` is generated by the elements `[n](x) - [1](γ_n(x))` for `x ∈ I` and
  `n > 0` (with `x` and `γ_n(x)` viewed in `J` via `A → B`), making the divided
  powers compatible with `γ`.

This file defines the two relation families and the ideals they generate, and
proves that the displayed generators belong to them.

## Main definitions

* `Rel1`, `Rel2'`: the two relation families on `Γ_B(J)`.
* `j1`, `j2`: the ideals generated by `Rel1` and `Rel2'`.
* `relationIdeal`, `j12`, `modifiedIdeal`: the ideal `J₁ + J₂` (three names for
  the same ideal).

## Main results

* `rel1_mem_j1`: `[1](x) - x ∈ J₁` for `x ∈ J`.
* `rel2'_mem_j2`: `[n](x) - [1](γ_n(x)) ∈ J₂` for `x ∈ I`, `n > 0`.
* `rel2'_mem_relationIdeal`: `[n](x) - γ_n(x) ∈ J₁₂` for `x ∈ I`, `n > 0`.

## References

* P. Berthelot and A. Ogus, *Notes on crystalline cohomology*, Mathematical
  Notes 21, Princeton University Press (1978), §3.
* [Stacks Project, Tag 07H8](https://stacks.math.columbia.edu/tag/07H8)
* A. Chambert-Loir and M. I. de Frutos-Fernández, *A formalization of divided
  powers in Lean*, ITP 2025, LIPIcs, 4:1–4:17.
* A. Chambert-Loir and M. I. de Frutos-Fernández, *Formalizing polynomial laws
  and the universal divided power algebra*, arXiv:2512.05750.
-/

open DividedPowerAlgebra DividedPowers Ideal

universe u v

noncomputable section

namespace AffineCrystalline
namespace Envelope
namespace FreeConstruction

section

variable {A : Type u} [CommRing A] {I : Ideal A} (hI : DividedPowers I)
  {B : Type v} [CommRing B] [Algebra A B] (J : Ideal B)

variable (hIJ : I.map (algebraMap A B) ≤ J)

local notation "Γ" => DividedPowerAlgebra B J

/-! ## The two relation families -/

/-- The first relation family: `[1](x) ~ x` for `x ∈ J`. -/
inductive Rel1 (J : Ideal B) : Rel (DividedPowerAlgebra B J) (DividedPowerAlgebra B J)
  | mk {x : J} : Rel1 J (DividedPowerAlgebra.embed B J x)
      (algebraMap B (DividedPowerAlgebra B J) (x : B))

lemma rel1_apply (x : J) :
    Rel1 J (DividedPowerAlgebra.embed B J x) (algebraMap B Γ (x : B)) :=
  Rel1.mk

/-- If `I B ⊆ J`, then the image of `γ_n(x)` in `B` lies in `J` for `x ∈ I` and
`n > 0`. -/
lemma algebraMap_dpow_mem (hIJ : I.map (algebraMap A B) ≤ J)
    (x : I) {n : ℕ} (hn : n ≠ 0) :
    algebraMap A B (hI.dpow n x) ∈ J := by
  apply hIJ
  exact Ideal.mem_map_of_mem (algebraMap A B) (hI.dpow_mem hn x.2)

/-- The second relation family: `[n](x) ~ [1](γ_n(x))` for `x ∈ I` and `n > 0`,
where `x` and `γ_n(x)` are viewed in `J` via `A → B`. -/
inductive Rel2' (hI : DividedPowers I) (J : Ideal B)
    (hIJ : I.map (algebraMap A B) ≤ J) :
    Rel (DividedPowerAlgebra B J) (DividedPowerAlgebra B J)
  | mk {x : I} {n : ℕ} (hn : n ≠ 0) :
      Rel2' hI J hIJ
        (DividedPowerAlgebra.dp B n
          (⟨algebraMap A B x, hIJ (Ideal.mem_map_of_mem (algebraMap A B) x.2)⟩ : J))
        (DividedPowerAlgebra.embed B J
          ⟨algebraMap A B (hI.dpow n x), algebraMap_dpow_mem hI J hIJ x hn⟩)

lemma rel2'_apply {x : I} {n : ℕ} (hn : n ≠ 0) :
    Rel2' hI J hIJ
      (DividedPowerAlgebra.dp B n
        (⟨algebraMap A B x, hIJ (Ideal.mem_map_of_mem (algebraMap A B) x.2)⟩ : J))
      (DividedPowerAlgebra.embed B J
        ⟨algebraMap A B (hI.dpow n x), algebraMap_dpow_mem hI J hIJ x hn⟩) :=
  Rel2'.mk hn

/-! ## The generated ideals -/

/-- The ideal generated by the first relation family. -/
noncomputable def j1 : Ideal Γ :=
  Ideal.ofRel (Rel1 J)

/-- The ideal generated by the second relation family. -/
noncomputable def j2 : Ideal Γ :=
  Ideal.ofRel (Rel2' hI J hIJ)

/-- The relation ideal `J₁₂ = J₁ + J₂` of the divided power envelope. -/
noncomputable def relationIdeal : Ideal Γ :=
  j1 J + j2 hI J hIJ

/-- The relation ideal `J₁₂ = J₁ + J₂`, under the name `j12`. -/
noncomputable def j12 : Ideal Γ :=
  relationIdeal hI J hIJ

/-- The relation ideal `J₁₂ = J₁ + J₂`, under the name `modifiedIdeal`. -/
noncomputable def modifiedIdeal : Ideal Γ :=
  relationIdeal hI J hIJ

/-! ## Membership of the displayed generators -/

lemma rel1_mem_j1 (x : J) :
    DividedPowerAlgebra.embed B J x - algebraMap B Γ (x : B) ∈ j1 J := by
  apply Ideal.subset_span
  exact ⟨DividedPowerAlgebra.embed B J x, algebraMap B Γ (x : B),
    rel1_apply J x, sub_add_cancel _ _⟩

lemma rel1_mem_relationIdeal (x : J) :
    DividedPowerAlgebra.embed B J x - algebraMap B Γ (x : B) ∈
      relationIdeal hI J hIJ :=
  mem_sup_left (rel1_mem_j1 J x)

lemma rel1_mem_j12 (x : J) :
    DividedPowerAlgebra.embed B J x - algebraMap B Γ (x : B) ∈
      j12 hI J hIJ :=
  rel1_mem_relationIdeal hI J hIJ x

lemma rel1_mem_modifiedIdeal (x : J) :
    DividedPowerAlgebra.embed B J x - algebraMap B Γ (x : B) ∈
      modifiedIdeal hI J hIJ :=
  rel1_mem_relationIdeal hI J hIJ x

lemma rel2'_mem_j2 (x : I) {n : ℕ} (hn : n ≠ 0) :
    DividedPowerAlgebra.dp B n
        (⟨algebraMap A B x,
          hIJ (Ideal.mem_map_of_mem (algebraMap A B) x.2)⟩ : J) -
      DividedPowerAlgebra.embed B J
        ⟨algebraMap A B (hI.dpow n x), algebraMap_dpow_mem hI J hIJ x hn⟩ ∈
        j2 hI J hIJ := by
  apply Ideal.subset_span
  exact ⟨DividedPowerAlgebra.dp B n
      (⟨algebraMap A B x,
        hIJ (Ideal.mem_map_of_mem (algebraMap A B) x.2)⟩ : J),
    DividedPowerAlgebra.embed B J
      ⟨algebraMap A B (hI.dpow n x), algebraMap_dpow_mem hI J hIJ x hn⟩,
    rel2'_apply hI J hIJ hn, sub_add_cancel _ _⟩

lemma rel2'_mem_relationIdeal (x : I) {n : ℕ} (hn : n ≠ 0) :
    DividedPowerAlgebra.dp B n
        (⟨algebraMap A B x,
          hIJ (Ideal.mem_map_of_mem (algebraMap A B) x.2)⟩ : J) -
      algebraMap B Γ (algebraMap A B (hI.dpow n x)) ∈
        relationIdeal hI J hIJ := by
  have h : _ ∈ j1 J + j2 hI J hIJ := add_mem (mem_sup_right (rel2'_mem_j2 hI J hIJ x hn))
    (mem_sup_left (rel1_mem_j1 J
      ⟨algebraMap A B (hI.dpow n x), algebraMap_dpow_mem hI J hIJ x hn⟩))
  rw [sub_add_sub_cancel] at h
  exact h

lemma rel2'_mem_j12 (x : I) {n : ℕ} (hn : n ≠ 0) :
    DividedPowerAlgebra.dp B n
        (⟨algebraMap A B x,
          hIJ (Ideal.mem_map_of_mem (algebraMap A B) x.2)⟩ : J) -
      algebraMap B Γ (algebraMap A B (hI.dpow n x)) ∈
        j12 hI J hIJ :=
  rel2'_mem_relationIdeal hI J hIJ x hn

lemma rel2'_mem_modifiedIdeal (x : I) {n : ℕ} (hn : n ≠ 0) :
    DividedPowerAlgebra.dp B n
        (⟨algebraMap A B x,
          hIJ (Ideal.mem_map_of_mem (algebraMap A B) x.2)⟩ : J) -
      algebraMap B Γ (algebraMap A B (hI.dpow n x)) ∈
        modifiedIdeal hI J hIJ :=
  rel2'_mem_relationIdeal hI J hIJ x hn

end

end FreeConstruction
end Envelope
end AffineCrystalline
