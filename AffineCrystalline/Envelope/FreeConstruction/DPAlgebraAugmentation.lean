import Mathlib.RingTheory.DividedPowerAlgebra.Init
import Mathlib.RingTheory.DividedPowers.SubDPIdeal

/-!
# The augmentation of the divided power algebra

Let `R` be a commutative ring and `M` an `R`-module. The divided power algebra
`Γ_R(M)` (`DividedPowerAlgebra R M`) is the quotient of the polynomial algebra
on symbols `[n](m)`, for `n ∈ ℕ` and `m ∈ M`, by Roby's relations. It carries an
augmentation `ε : Γ_R(M) → R` sending `[0](m)` to `1` and `[n](m)` to `0` for
`n > 0`. We define the positive ideal `Γ⁺` as the ideal generated by the
`[n](m)` with `n > 0`, and prove that it is the kernel of `ε`, so that
`Γ_R(M) ⧸ Γ⁺ ≅ R`.

A classical theorem of Roby states that `Γ⁺` carries a unique divided power
structure with `γ_n([k](m)) = (nk)! / (n! (k!)ⁿ) · [nk](m)`. We prove the
uniqueness part: a divided power structure on `Γ⁺` is determined by its values
on the generators `[k](m)`. The existence part is not proved here; it is
recorded as the structure `PositiveDPStructure`.

## Main definitions

* `augmentation`: the augmentation `ε : Γ_R(M) → R`.
* `positiveGenerators`, `positiveIdeal`: the generators `[n](m)`, `n > 0`, and
  the ideal `Γ⁺` they generate.
* `positiveQuotientEquiv`: the isomorphism `Γ_R(M) ⧸ Γ⁺ ≃ R` induced by `ε`.
* `generatorDpow`: the element
  `(nk)! / (n! (k!)ⁿ) · [nk](m)` of `Γ_R(M)`.
* `PositiveDPStructure`: divided powers on `Γ⁺` satisfying
  `γ_n([k](m)) = generatorDpow n k m` for `k > 0`.

## Main results

* `positiveIdeal_eq_augmentation_ker`: `Γ⁺ = ker ε`.
* `sub_augmentation_mem_positiveIdeal`: `x - ε(x) ∈ Γ⁺` for every `x`.
* `dividedPowers_eq_of_positiveGenerator_agreement`: two divided power
  structures on `Γ⁺` that agree on the generators `[n](m)` are equal.

## References

* N. Roby, *Lois polynômes et lois formelles en théorie des modules*,
  Ann. Sci. École Norm. Sup. (3) 80 (1963), 213–348.
* N. Roby, *Les algèbres à puissances divisées*, Bull. Sci. Math. (2) 89 (1965),
  75–91.
* A. Chambert-Loir and M. I. de Frutos-Fernández, *A formalization of divided
  powers in Lean*, ITP 2025, LIPIcs, 4:1–4:17.
* A. Chambert-Loir and M. I. de Frutos-Fernández, *Formalizing polynomial laws
  and the universal divided power algebra*, arXiv:2512.05750.
-/

open DividedPowers
open scoped BigOperators

universe u

noncomputable section

namespace AffineCrystalline
namespace Envelope
namespace FreeConstruction

/-! ## The augmentation and its positive ideal -/

section Augmentation

variable {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]

local notation "Γ" => DividedPowerAlgebra R M

/-- The augmentation `ε : Γ_R(M) → R`, sending `[0](m)` to `1` and `[n](m)` to
`0` for `n > 0`. It is well defined because these values satisfy Roby's
relations, as checked in the arguments to `DividedPowerAlgebra.lift'`. -/
noncomputable def augmentation : Γ →ₐ[R] R :=
  DividedPowerAlgebra.lift'
    (f := fun nm : ℕ × M ↦ if nm.1 = 0 then 1 else 0)
    (by intro m; simp)
    (by
      intro n r m
      by_cases hn : n = 0 <;> simp [hn])
    (by
      intro n p m
      by_cases hn : n = 0 <;> by_cases hp : p = 0 <;> simp [hn, hp])
    (by
      intro n u v
      by_cases hn : n = 0
      · subst n
        simp
      · have hfirst : (n, u + v).1 ≠ 0 := by simpa using hn
        rw [if_neg hfirst]
        symm
        apply Finset.sum_eq_zero
        intro k hk
        by_cases hk₁ : k.1 = 0
        · have hk₂ : k.2 ≠ 0 := by
            intro hk₂
            apply hn
            have hkn := Finset.mem_antidiagonal.mp hk
            simpa [hk₁, hk₂] using hkn.symm
          simp [hk₁, hk₂]
        · simp [hk₁])

@[simp]
theorem augmentation_apply_dp (n : ℕ) (m : M) :
    augmentation (R := R) (M := M) (DividedPowerAlgebra.dp R n m) =
      if n = 0 then 1 else 0 := by
  rw [augmentation, DividedPowerAlgebra.lift'_apply_dp]

@[simp]
theorem augmentation_apply_algebraMap (r : R) :
    augmentation (R := R) (M := M) (algebraMap R Γ r) = r :=
  (augmentation (R := R) (M := M)).commutes r

/-- The set of generators `[n](m)` of `Γ_R(M)` with `n > 0`. -/
def positiveGenerators : Set Γ :=
  {x | ∃ n : ℕ, n ≠ 0 ∧ ∃ m : M, x = DividedPowerAlgebra.dp R n m}

/-- The positive ideal `Γ⁺`, generated by the `[n](m)` with `n > 0`. -/
def positiveIdeal : Ideal Γ :=
  Ideal.span (positiveGenerators (R := R) (M := M))

theorem dp_mem_positiveIdeal {n : ℕ} (hn : n ≠ 0) (m : M) :
    DividedPowerAlgebra.dp R n m ∈ positiveIdeal (R := R) (M := M) := by
  apply Ideal.subset_span
  exact ⟨n, hn, m, rfl⟩

theorem positiveIdeal_le_augmentation_ker :
    positiveIdeal (R := R) (M := M) ≤
      RingHom.ker (augmentation (R := R) (M := M)).toRingHom := by
  rw [positiveIdeal, Ideal.span_le]
  rintro x ⟨n, hn, m, rfl⟩
  change augmentation (R := R) (M := M) (DividedPowerAlgebra.dp R n m) = 0
  simp [hn]

end Augmentation

/-! ## The kernel of the augmentation -/

section AugmentationKernel

variable {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]

local notation "Γ" => DividedPowerAlgebra R M

/-- Every `x ∈ Γ_R(M)` satisfies `x - ε(x) ∈ Γ⁺`. The proof is by induction on
`x`: for a product `x · [n](m)` with `n > 0`, write it as
`(x - ε(x)) · [n](m) + ε(x) · [n](m)`. -/
theorem sub_augmentation_mem_positiveIdeal (x : Γ) :
    x - algebraMap R Γ (augmentation (R := R) (M := M) x) ∈
      positiveIdeal (R := R) (M := M) := by
  induction x using DividedPowerAlgebra.induction_on with
  | C r => simp [positiveIdeal]
  | add x y hx hy =>
    convert add_mem hx hy using 1
    rw [map_add, map_add]
    ring
  | dp x n m hx =>
    rcases eq_or_ne n 0 with rfl | hn
    · simpa [DividedPowerAlgebra.dp_zero] using hx
    have h := add_mem (Ideal.mul_mem_right (DividedPowerAlgebra.dp R n m) _ hx)
      (Ideal.mul_mem_left _ (algebraMap R Γ (augmentation (R := R) (M := M) x))
        (dp_mem_positiveIdeal hn m))
    simp only [map_mul, augmentation_apply_dp, if_neg hn, mul_zero, map_zero, sub_zero]
    convert h using 1
    ring

theorem augmentation_ker_le_positiveIdeal :
    RingHom.ker (augmentation (R := R) (M := M)).toRingHom ≤
      positiveIdeal (R := R) (M := M) := by
  intro x hx
  change augmentation (R := R) (M := M) x = 0 at hx
  have hres := sub_augmentation_mem_positiveIdeal (R := R) (M := M) x
  simpa [hx] using hres

/-- The positive ideal `Γ⁺` is the kernel of the augmentation. -/
theorem positiveIdeal_eq_augmentation_ker :
    positiveIdeal (R := R) (M := M) =
      RingHom.ker (augmentation (R := R) (M := M)).toRingHom :=
  le_antisymm
    (positiveIdeal_le_augmentation_ker (R := R) (M := M))
    (augmentation_ker_le_positiveIdeal (R := R) (M := M))

theorem augmentation_surjective :
    Function.Surjective (augmentation (R := R) (M := M)).toRingHom := by
  intro r
  refine ⟨algebraMap R Γ r, ?_⟩
  simp

/-- The isomorphism `Γ_R(M) ⧸ Γ⁺ ≃ R` induced by the augmentation. -/
noncomputable def positiveQuotientEquiv :
    Γ ⧸ positiveIdeal (R := R) (M := M) ≃+* R :=
  (Ideal.quotEquivOfEq (positiveIdeal_eq_augmentation_ker (R := R) (M := M))).trans
    (RingHom.quotientKerEquivOfSurjective
      (augmentation_surjective (R := R) (M := M)))

@[simp]
theorem positiveQuotientEquiv_apply_mk (x : Γ) :
    positiveQuotientEquiv (R := R) (M := M)
        (Ideal.Quotient.mk (positiveIdeal (R := R) (M := M)) x) =
      augmentation (R := R) (M := M) x := by
  rw [positiveQuotientEquiv, RingEquiv.trans_apply,
    Ideal.quotEquivOfEq_mk,
    RingHom.quotientKerEquivOfSurjective_apply_mk,
    AlgHom.toRingHom_eq_coe]
  rfl

end AugmentationKernel

/-! ## Divided powers on the positive ideal -/

section GeneratorData

variable {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M]

local notation "Γ" => DividedPowerAlgebra R M

/-- The element `(nk)! / (n! (k!)ⁿ) · [nk](m)` of `Γ_R(M)`. If `Γ⁺` has divided
powers `γ` with `γ_k([1](m)) = [k](m)` for all `k` and `m`, then the composition law
`DividedPowers.dpow_comp` forces `γ_n([k](m))` to equal this element. -/
def generatorDpow (n k : ℕ) (m : M) : Γ :=
  (Nat.uniformBell n k : Γ) * DividedPowerAlgebra.dp R (n * k) m

theorem generatorDpow_mem {n k : ℕ} (hn : n ≠ 0) (hk : k ≠ 0) (m : M) :
    generatorDpow (R := R) (M := M) n k m ∈
      positiveIdeal (R := R) (M := M) := by
  unfold generatorDpow
  exact (positiveIdeal (R := R) (M := M)).mul_mem_left _
    (dp_mem_positiveIdeal (Nat.mul_ne_zero hn hk) m)

theorem generatorDpow_one_left (k : ℕ) (m : M) :
    generatorDpow (R := R) (M := M) 1 k m =
      DividedPowerAlgebra.dp R k m := by
  simp [generatorDpow, Nat.uniformBell_one_left]

theorem generatorDpow_one_right (n : ℕ) (m : M) :
    generatorDpow (R := R) (M := M) n 1 m =
      DividedPowerAlgebra.dp R n m := by
  simp [generatorDpow, Nat.uniformBell_one_right]

theorem positiveIdeal_eq_span_positiveGenerators :
    positiveIdeal (R := R) (M := M) =
      Ideal.span (positiveGenerators (R := R) (M := M)) :=
  rfl

/-- A divided power structure on `Γ⁺` is determined by its values on the
generators `[n](m)`, `n > 0`. -/
theorem dividedPowers_eq_of_positiveGenerator_agreement
    {h₁ h₂ : DividedPowers (positiveIdeal (R := R) (M := M))}
    (hgen : ∀ {n : ℕ} {x : Γ}, x ∈ positiveGenerators (R := R) (M := M) →
      h₁.dpow n x = h₂.dpow n x) :
    h₂ = h₁ := by
  apply DividedPowers.dpow_eq_from_gens h₁ h₂
    (positiveIdeal_eq_span_positiveGenerators (R := R) (M := M))
  intro n x hx
  exact hgen hx

/-! ## Roby's divided powers on the positive ideal -/

/-- Divided powers `γ` on `Γ⁺` satisfying
`γ_n([k](m)) = (nk)! / (n! (k!)ⁿ) · [nk](m)` for all `k > 0`. By a theorem of
Roby such a structure exists and, by
`dividedPowers_eq_of_positiveGenerator_agreement`, it is unique. -/
structure PositiveDPStructure where
  dividedPowers : DividedPowers (positiveIdeal (R := R) (M := M))
  generator_formula : ∀ {n k : ℕ} {m : M}, k ≠ 0 →
    dividedPowers.dpow n (DividedPowerAlgebra.dp R k m) =
      generatorDpow (R := R) (M := M) n k m

end GeneratorData

end FreeConstruction
end Envelope
end AffineCrystalline
