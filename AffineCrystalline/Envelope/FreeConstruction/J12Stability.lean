import AffineCrystalline.Envelope.FreeConstruction.PositiveIdeal

/-!
# Stability of the relation ideal under divided powers

Let `(A, I, γ)` be a divided power ring, `B` an `A`-algebra and `J ⊆ B` an ideal
with `I B ⊆ J`, and let `δ` be Roby's divided powers on the positive ideal `Γ⁺`
of `Γ_B(J)` (`PositiveDPStructure`). The divided power envelope is the
quotient of `Γ_B(J)` by `J₁₂ = J₁ + J₂`, and `δ` descends to it if `J₁₂ ⊓ Γ⁺` is a
sub-divided power ideal of `(Γ⁺, δ)`.

We reduce this property to three statements, collected in the structure
`J12CompatibilityData`:

* `J₁₂ ⊓ Γ⁺ = (J₁ ⊓ Γ⁺) + J₂`;
* `J₁ ⊓ Γ⁺ = Γ⁺ · J₁`, which is a sub-divided power ideal by Mathlib;
* `δ_r(g) ∈ J₂` for every `r > 0` and every generator
  `g = [n](x) - [1](γ_n(x))` of `J₂`.

Since `J₂` is generated by elements of `Γ⁺`, the last statement implies that
`J₂` is a sub-divided power ideal.

## Main definitions

* `rel2Generator`, `rel2Generators`: the generators of `J₂`.
* `J12CompatibilityData`: the three statements above.

## Main results

* `j2_eq_span_rel2Generators`: `J₂` is the ideal generated by `rel2Generators`.
* `rel2Generators_subset_positiveIdeal`: these generators lie in `Γ⁺`.
* `J12CompatibilityData.j2_isSubDPIdeal`: `J₂` is a sub-divided power
  ideal.
* `J12CompatibilityData.intersection_isSubDPIdeal`: `J₁₂ ⊓ Γ⁺` is a
  sub-divided power ideal.

## References

* P. Berthelot and A. Ogus, *Notes on crystalline cohomology*, Mathematical
  Notes 21, Princeton University Press (1978), §3.
* [Stacks Project, Tag 07H8](https://stacks.math.columbia.edu/tag/07H8)
* A. Chambert-Loir and M. I. de Frutos-Fernández, *A formalization of divided
  powers in Lean*, ITP 2025, LIPIcs, 4:1–4:17.
* A. Chambert-Loir and M. I. de Frutos-Fernández, *Formalizing polynomial laws
  and the universal divided power algebra*, arXiv:2512.05750.
-/

open DividedPowerAlgebra DividedPowers Ideal

universe u v

noncomputable section

namespace AffineCrystalline
namespace Envelope
namespace FreeConstruction

section J12Stability

variable {A : Type u} [CommRing A] {I : Ideal A} (hI : DividedPowers I)
  {B : Type v} [CommRing B] [Algebra A B] (J : Ideal B)
  (hIJ : I.map (algebraMap A B) ≤ J)

local notation "Γ" => DividedPowerAlgebra B J

variable (P : PositiveDPStructure (R := B) (M := J))

/-! ## Generators of the second relation ideal -/

/-- The generator `[n](x) - [1](γ_n(x))` of `J₂`, for `x ∈ I` and `n > 0`. -/
def rel2Generator (x : I) {n : ℕ} (hn : n ≠ 0) : Γ :=
  DividedPowerAlgebra.dp B n
      (⟨algebraMap A B x,
        hIJ (Ideal.mem_map_of_mem (algebraMap A B) x.2)⟩ : J) -
    DividedPowerAlgebra.embed B J
      ⟨algebraMap A B (hI.dpow n x),
        algebraMap_dpow_mem hI J hIJ x hn⟩

/-- The set of generators `[n](x) - [1](γ_n(x))` of `J₂`. -/
def rel2Generators : Set Γ :=
  {z | ∃ (x : I) (n : ℕ) (hn : n ≠ 0), z = rel2Generator hI J hIJ x hn}

theorem rel2Generator_mem_positiveIdeal {x : I} {n : ℕ} (hn : n ≠ 0) :
    rel2Generator hI J hIJ x hn ∈ positiveIdeal (R := B) (M := J) := by
  apply (positiveIdeal (R := B) (M := J)).sub_mem
  · exact dp_mem_positiveIdeal (R := B) (M := J) hn _
  · rw [DividedPowerAlgebra.embed_def]
    exact dp_mem_positiveIdeal (R := B) (M := J) one_ne_zero _

theorem rel2Generators_subset_positiveIdeal :
    rel2Generators hI J hIJ ⊆ positiveIdeal (R := B) (M := J) := by
  rintro z ⟨x, n, hn, rfl⟩
  exact rel2Generator_mem_positiveIdeal hI J hIJ hn

theorem j2_eq_span_rel2Generators :
    j2 hI J hIJ = Ideal.span (rel2Generators hI J hIJ) := by
  apply le_antisymm
  · rw [j2, Ideal.ofRel, Ideal.span_le]
    rintro z ⟨a, b, hab, hz⟩
    have hz' : z = a - b := eq_sub_of_add_eq hz
    obtain @⟨x, n, hn⟩ := hab
    exact Ideal.subset_span ⟨x, n, hn, by simpa [rel2Generator] using hz'⟩
  · rw [Ideal.span_le]
    rintro z ⟨x, n, hn, rfl⟩
    exact rel2'_mem_j2 hI J hIJ x hn

/-! ## Reduction of the stability of `J₁₂ ⊓ Γ⁺` -/

/--
Data implying that `J₁₂ ⊓ Γ⁺` is a sub-divided power ideal of `(Γ⁺, δ)`:

* `intersection_eq_sum`: `J₁₂ ⊓ Γ⁺ = (J₁ ⊓ Γ⁺) + J₂`;
* `j1_intersection_eq_prod`: `J₁ ⊓ Γ⁺ = Γ⁺ · J₁`;
* `rel2_dpow_mem`: `δ_r(g) ∈ J₂` for `r > 0` and every generator `g` of `J₂`.
-/
structure J12CompatibilityData where
  intersection_eq_sum :
    j12 hI J hIJ ⊓ positiveIdeal (R := B) (M := J) =
      (j1 J ⊓ positiveIdeal (R := B) (M := J)) + j2 hI J hIJ
  j1_intersection_eq_prod :
    j1 J ⊓ positiveIdeal (R := B) (M := J) =
      positiveIdeal (R := B) (M := J) • j1 J
  rel2_dpow_mem :
    ∀ {r : ℕ}, r ≠ 0 → ∀ (x : I) {n : ℕ} (hn : n ≠ 0),
      P.dividedPowers.dpow r (rel2Generator hI J hIJ x hn) ∈
        j2 hI J hIJ

namespace J12CompatibilityData

variable (D : J12CompatibilityData hI J hIJ P)

theorem j1_intersection_isSubDPIdeal
    (D : J12CompatibilityData hI J hIJ P) :
    IsSubDPIdeal P.dividedPowers
      (j1 J ⊓ positiveIdeal (R := B) (M := J)) := by
  rw [J12CompatibilityData.j1_intersection_eq_prod D]
  exact
    (DividedPowers.SubDPIdeal.prod (hI := P.dividedPowers) (j1 J)).toIsSubDPIdeal

theorem j2_isSubDPIdeal
    (D : J12CompatibilityData hI J hIJ P) :
    IsSubDPIdeal P.dividedPowers (j2 hI J hIJ) := by
  rw [j2_eq_span_rel2Generators hI J hIJ]
  apply (span_isSubDPIdeal_iff
    (rel2Generators_subset_positiveIdeal hI J hIJ)).2
  rintro r hr z ⟨x, n, hn, rfl⟩
  simpa only [j2_eq_span_rel2Generators hI J hIJ] using
    (J12CompatibilityData.rel2_dpow_mem D hr x hn)

theorem j2_isSubideal
    (D : J12CompatibilityData hI J hIJ P) :
    j2 hI J hIJ ≤ positiveIdeal (R := B) (M := J) :=
  (J12CompatibilityData.j2_isSubDPIdeal
    (hI := hI) (J := J) (hIJ := hIJ) (P := P) D).isSubideal

theorem intersection_isSubDPIdeal
    (D : J12CompatibilityData hI J hIJ P) :
    IsSubDPIdeal P.dividedPowers
      (j12 hI J hIJ ⊓ positiveIdeal (R := B) (M := J)) := by
  rw [J12CompatibilityData.intersection_eq_sum D]
  have hsum :
      IsSubDPIdeal P.dividedPowers
        ((j1 J ⊓ positiveIdeal (R := B) (M := J)) ⊔ j2 hI J hIJ) :=
    isSubDPIdeal_sup
      (J12CompatibilityData.j1_intersection_isSubDPIdeal
        (hI := hI) (J := J) (hIJ := hIJ) (P := P) D)
      (J12CompatibilityData.j2_isSubDPIdeal
        (hI := hI) (J := J) (hIJ := hIJ) (P := P) D)
  simpa only [Submodule.add_eq_sup] using hsum

end J12CompatibilityData

end J12Stability

end FreeConstruction
end Envelope
end AffineCrystalline
