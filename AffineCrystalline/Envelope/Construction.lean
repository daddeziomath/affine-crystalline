import AffineCrystalline.PDDifferentials
import Mathlib.RingTheory.DividedPowers.SubDPIdeal
import Mathlib.RingTheory.MvPolynomial.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Existence of divided power envelopes

Let `(A, I, γ)` be a divided power ring, `P` an `A`-algebra and `J ⊆ P` an ideal.
We construct the divided power envelope `D_{P,γ}(J)` and prove its universal
property (`IsDPEnvelope`), so that `HasDPEnvelope γ J` holds for every `J`.

The construction follows the representability argument of [Stacks, Tag 07H8]:
the envelope is a sub-object of a product of all "small" divided power algebras
under `P`. To stay in the universe of `P`, these are indexed by ideals of a fixed
polynomial ring.

Let `R = P[X(n, f) : n ∈ ℕ, f ∈ J]`; the variable `X(n, f)` stands for the
divided power `δ_{n+1}(f)`. For an ideal `𝔞 ⊆ R`, let `K(𝔞) ⊆ R/𝔞` be the ideal
generated by the classes of the variables and by `I`. An *admissible pair* is an
ideal `𝔞` with divided powers `δ` on `K(𝔞)` such that the class of every `f ∈ J`
lies in `K(𝔞)`, `X(n, f) = δ_{n+1}(f)` in `R/𝔞`, and `A → R/𝔞` is a divided power
morphism. The envelope is `Env = R/𝔟`, where `𝔟` is the kernel of
`R → ∏_s R/𝔞_s` over all admissible pairs `s`. It embeds into the product, and
`K(𝔟)` inherits the componentwise divided powers.

Given a divided power algebra `(D', K', δ')` under `P` compatible with `γ`, the
kernel `𝔞` of the evaluation `R → D'`, `X(n, f) ↦ δ'_{n+1}(f)`, gives an
admissible pair with `R/𝔞 ⊆ D'`; the projection to that factor is the required
map `Env → D'`. It is unique because `Env` is generated over `P` by the classes
of the variables.

## Main definitions

* `piDividedPowers`, `restrictDividedPowers`: divided powers on a product of
  ideals, and their restriction along an injective map.
* `DPEnvelope.Env`, `DPEnvelope.envMap`, `DPEnvelope.envPDIdeal`,
  `DPEnvelope.envDividedPowers`: the envelope and its structure.
* `DPEnvelope.dpEnvelopeChoice`: the envelope as a `DPEnvelopeChoice`.

## Main results

* `DPEnvelope.existsUnique_lift`: the universal property.
* `DPEnvelope.env_isDPEnvelope`: the envelope satisfies `IsDPEnvelope`.
* `DPEnvelope.hasDPEnvelope`: every ideal has a divided power envelope.

## References

* [Stacks Project, Tag 07H8](https://stacks.math.columbia.edu/tag/07H8)
* [Stacks Project, Tag 07GV](https://stacks.math.columbia.edu/tag/07GV)
* [Stacks Project, Tag 07GW](https://stacks.math.columbia.edu/tag/07GW)
-/

open DividedPowers MvPolynomial

universe u v

namespace AffineCrystalline.DPEnvelope

/-! ## Divided powers on products -/

section Pi

variable {ι : Type*} {R : ι → Type*} [∀ i, CommRing (R i)] {K : ∀ i, Ideal (R i)}
  (δ : ∀ i, DividedPowers (K i))

open scoped Classical in
/-- The componentwise divided power structure on `Ideal.pi K`. -/
noncomputable def piDividedPowers : DividedPowers (Ideal.pi K) where
  dpow n x := if x ∈ Ideal.pi K then fun i ↦ (δ i).dpow n (x i) else 0
  dpow_null hx := if_neg hx
  dpow_zero {x} hx := by
    rw [if_pos hx]
    funext i
    exact (δ i).dpow_zero ((Ideal.mem_pi _ _).1 hx i)
  dpow_one {x} hx := by
    rw [if_pos hx]
    funext i
    exact (δ i).dpow_one ((Ideal.mem_pi _ _).1 hx i)
  dpow_mem {n x} hn hx := by
    rw [if_pos hx]
    exact (Ideal.mem_pi _ _).2 fun i ↦ (δ i).dpow_mem hn ((Ideal.mem_pi _ _).1 hx i)
  dpow_add {n x y} hx hy := by
    have hxy : x + y ∈ Ideal.pi K := add_mem hx hy
    simp only [if_pos hx, if_pos hy, if_pos hxy]
    funext i
    simp only [Pi.add_apply, Finset.sum_apply, Pi.mul_apply]
    exact (δ i).dpow_add ((Ideal.mem_pi _ _).1 hx i) ((Ideal.mem_pi _ _).1 hy i)
  dpow_mul {n a x} hx := by
    have hax : a * x ∈ Ideal.pi K := Ideal.mul_mem_left _ a hx
    simp only [if_pos hx, if_pos hax]
    funext i
    simp only [Pi.mul_apply, Pi.pow_apply]
    exact (δ i).dpow_mul ((Ideal.mem_pi _ _).1 hx i)
  mul_dpow {m n x} hx := by
    simp only [if_pos hx]
    funext i
    simp only [Pi.mul_apply, Pi.natCast_apply]
    exact (δ i).mul_dpow ((Ideal.mem_pi _ _).1 hx i)
  dpow_comp {m n x} hn hx := by
    have hnx : (fun i ↦ (δ i).dpow n (x i)) ∈ Ideal.pi K :=
      (Ideal.mem_pi _ _).2 fun i ↦ (δ i).dpow_mem hn ((Ideal.mem_pi _ _).1 hx i)
    simp only [if_pos hx, if_pos hnx]
    funext i
    simp only [Pi.mul_apply, Pi.natCast_apply]
    exact (δ i).dpow_comp hn ((Ideal.mem_pi _ _).1 hx i)

theorem piDividedPowers_dpow_apply (n : ℕ) {x : ∀ i, R i} (hx : x ∈ Ideal.pi K) (i : ι) :
    (piDividedPowers δ).dpow n x i = (δ i).dpow n (x i) := by
  simp [piDividedPowers, hx]

/-- The projections are divided power morphisms. -/
theorem isDPMorphism_piEval (i : ι) :
    (piDividedPowers δ).IsDPMorphism (δ i) (Pi.evalRingHom R i) where
  ideal_comp := Ideal.map_le_iff_le_comap.2 fun _ hx ↦ (Ideal.mem_pi _ _).1 hx i
  dpow_comp _ ha := (piDividedPowers_dpow_apply δ _ ha i).symm

end Pi

/-! ## Restriction along an injective map -/

section Restrict

variable {S T : Type*} [CommRing S] [CommRing T] (f : S →+* T) (hf : Function.Injective f)
  {KT : Ideal T} (δT : DividedPowers KT) (KS : Ideal S) (hle : KS.map f ≤ KT)
  (hstab : ∀ n ≠ 0, ∀ x ∈ KS, ∃ y ∈ KS, f y = δT.dpow n (f x))

open scoped Classical in
/-- The underlying function of `restrictDividedPowers` is compatible with `δT`
through `f`. -/
private theorem restrictDpow_apply (hle : KS.map f ≤ KT) (n : ℕ) {x : S} (hx : x ∈ KS) :
    f (if hx : x ∈ KS then (if hn : n = 0 then 1 else Classical.choose (hstab n hn x hx))
      else 0) = δT.dpow n (f x) := by
  rw [dif_pos hx]
  split_ifs with hn
  · rw [hn, map_one, δT.dpow_zero (hle (Ideal.mem_map_of_mem f hx))]
  · exact (Classical.choose_spec (hstab n hn x hx)).2

open scoped Classical in
/-- The underlying function of `restrictDividedPowers` takes values in `KS` in
positive degrees. -/
private theorem restrictDpow_mem {n : ℕ} (hn : n ≠ 0) {x : S} (hx : x ∈ KS) :
    (if hx : x ∈ KS then (if hn : n = 0 then 1 else Classical.choose (hstab n hn x hx))
      else 0) ∈ KS := by
  rw [dif_pos hx, dif_neg hn]
  exact (Classical.choose_spec (hstab n hn x hx)).1

open scoped Classical in
/-- The divided power structure on `KS` induced by `δT` through the injective
map `f`. -/
noncomputable def restrictDividedPowers {S T : Type*} [CommRing S] [CommRing T] (f : S →+* T)
    (_hf : Function.Injective f) {KT : Ideal T} (δT : DividedPowers KT) (KS : Ideal S)
    (_hle : KS.map f ≤ KT)
    (hstab : ∀ n ≠ 0, ∀ x ∈ KS, ∃ y ∈ KS, f y = δT.dpow n (f x)) : DividedPowers KS where
  dpow n x :=
    if hx : x ∈ KS then (if hn : n = 0 then 1 else Classical.choose (hstab n hn x hx)) else 0
  dpow_null hx := dif_neg hx
  dpow_zero hx := by rw [dif_pos hx, dif_pos rfl]
  dpow_one {x} hx := by
    apply _hf
    rw [restrictDpow_apply f δT KS hstab _hle 1 hx,
      δT.dpow_one (_hle (Ideal.mem_map_of_mem f hx))]
  dpow_mem hn hx := restrictDpow_mem f δT KS hstab hn hx
  dpow_add {n x y} hx hy := by
    have hfx := _hle (Ideal.mem_map_of_mem f hx)
    have hfy := _hle (Ideal.mem_map_of_mem f hy)
    apply _hf
    rw [restrictDpow_apply f δT KS hstab _hle n (add_mem hx hy), map_add,
      δT.dpow_add hfx hfy, map_sum]
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    rw [map_mul, restrictDpow_apply f δT KS hstab _hle _ hx,
      restrictDpow_apply f δT KS hstab _hle _ hy]
  dpow_mul {n a x} hx := by
    apply _hf
    rw [restrictDpow_apply f δT KS hstab _hle n (Ideal.mul_mem_left _ a hx), map_mul,
      δT.dpow_mul (_hle (Ideal.mem_map_of_mem f hx)), map_mul, map_pow,
      restrictDpow_apply f δT KS hstab _hle n hx]
  mul_dpow {m n x} hx := by
    apply _hf
    rw [map_mul, map_mul, map_natCast, restrictDpow_apply f δT KS hstab _hle _ hx,
      restrictDpow_apply f δT KS hstab _hle _ hx, restrictDpow_apply f δT KS hstab _hle _ hx,
      δT.mul_dpow (_hle (Ideal.mem_map_of_mem f hx))]
  dpow_comp {m n x} hn hx := by
    apply _hf
    rw [restrictDpow_apply f δT KS hstab _hle m (restrictDpow_mem f δT KS hstab hn hx),
      restrictDpow_apply f δT KS hstab _hle n hx, map_mul, map_natCast,
      restrictDpow_apply f δT KS hstab _hle _ hx,
      δT.dpow_comp hn (_hle (Ideal.mem_map_of_mem f hx))]

theorem restrictDividedPowers_apply (n : ℕ) {x : S} (hx : x ∈ KS) :
    f ((restrictDividedPowers f hf δT KS hle hstab).dpow n x) = δT.dpow n (f x) :=
  restrictDpow_apply f δT KS hstab hle n hx

theorem isDPMorphism_restrictDividedPowers :
    (restrictDividedPowers f hf δT KS hle hstab).IsDPMorphism δT f where
  ideal_comp := hle
  dpow_comp _ ha := (restrictDividedPowers_apply f hf δT KS hle hstab _ ha).symm

end Restrict

/-! ## Stability on generators -/

section Generators

variable {S T : Type*} [CommRing S] [CommRing T] (f : S →+* T) {KT : Ideal T}
  (δT : DividedPowers KT)

/-- Let `x, y ∈ S` with `f x, f y ∈ KT`. If every divided power of `f x` and of `f y`
is the image of an element of `S`, lying in the ideal `L` in positive degrees, then
the same holds for `f (x + y)`. This is the additivity step in the proof of
`exists_dpow_mem_span`. -/
theorem exists_map_eq_dpow_add {L : Ideal S} {x y : S} (hfx : f x ∈ KT) (hfy : f y ∈ KT)
    (hx : ∀ n, ∃ u, (n ≠ 0 → u ∈ L) ∧ f u = δT.dpow n (f x))
    (hy : ∀ n, ∃ v, (n ≠ 0 → v ∈ L) ∧ f v = δT.dpow n (f y)) (n : ℕ) :
    ∃ w, (n ≠ 0 → w ∈ L) ∧ f w = δT.dpow n (f (x + y)) := by
  choose u hu hfu using hx
  choose v hv hfv using hy
  refine ⟨∑ k ∈ Finset.antidiagonal n, u k.1 * v k.2, fun hn ↦ ?_, ?_⟩
  · refine sum_mem fun k hk ↦ ?_
    rw [Finset.mem_antidiagonal] at hk
    by_cases hk1 : k.1 = 0
    · exact Ideal.mul_mem_left _ _ (hv _ (by omega))
    · exact Ideal.mul_mem_right _ _ (hu _ hk1)
  · rw [map_add, δT.dpow_add hfx hfy, map_sum]
    exact Finset.sum_congr rfl fun k _ ↦ by rw [map_mul, hfu, hfv]

/-- If the divided powers of the images of generators of an ideal `span G` lie in
the image of `span G`, the same holds for every element of `span G`. -/
theorem exists_dpow_mem_span (G : Set S) (hG : ∀ g ∈ G, f g ∈ KT)
    (hgen : ∀ n ≠ 0, ∀ g ∈ G, ∃ y ∈ Ideal.span G, f y = δT.dpow n (f g)) :
    ∀ n ≠ 0, ∀ x ∈ Ideal.span G, ∃ y ∈ Ideal.span G, f y = δT.dpow n (f x) := by
  /- We prove the stronger statement that `f x ∈ KT` and that every divided power
  of `f x` is the image of an element of `S`, lying in `span G` in positive degrees. -/
  suffices H : ∀ x ∈ Ideal.span G, f x ∈ KT ∧
      ∀ n, ∃ y, (n ≠ 0 → y ∈ Ideal.span G) ∧ f y = δT.dpow n (f x) by
    intro n hn x hx
    obtain ⟨y, hy, hfy⟩ := (H x hx).2 n
    exact ⟨y, hy hn, hfy⟩
  intro x hx
  induction hx using Submodule.span_induction with
  | mem g hg =>
    refine ⟨hG g hg, fun n ↦ ?_⟩
    by_cases hn : n = 0
    · exact ⟨1, fun h ↦ absurd hn h, by rw [hn, map_one, δT.dpow_zero (hG g hg)]⟩
    · obtain ⟨y, hy, hfy⟩ := hgen n hn g hg
      exact ⟨y, fun _ ↦ hy, hfy⟩
  | zero =>
    refine ⟨by rw [map_zero]; exact zero_mem _, fun n ↦ ?_⟩
    by_cases hn : n = 0
    · exact ⟨1, fun h ↦ absurd hn h, by rw [hn, map_one, map_zero, δT.dpow_zero (zero_mem _)]⟩
    · exact ⟨0, fun _ ↦ zero_mem _, by rw [map_zero, δT.dpow_eval_zero hn]⟩
  | add x y _ _ hx hy =>
    exact ⟨by rw [map_add]; exact add_mem hx.1 hy.1,
      exists_map_eq_dpow_add f δT hx.1 hy.1 hx.2 hy.2⟩
  | smul a x _ hx =>
    obtain ⟨hfx, hx⟩ := hx
    refine ⟨by rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ hfx, fun n ↦ ?_⟩
    obtain ⟨u, hu, hfu⟩ := hx n
    refine ⟨a ^ n * u, fun hn ↦ Ideal.mul_mem_left _ _ (hu hn), ?_⟩
    rw [smul_eq_mul, map_mul, map_mul, map_pow, hfu, δT.dpow_mul hfx]

end Generators

theorem map_span_le {S T : Type*} [CommRing S] [CommRing T] (f : S →+* T)
    (KT : Ideal T) (G : Set S) (hG : ∀ g ∈ G, f g ∈ KT) :
    (Ideal.span G).map f ≤ KT := by
  rw [Ideal.map_span, Ideal.span_le]
  rintro _ ⟨g, hg, rfl⟩
  exact hG g hg

/-! ## The construction -/

section Construction

variable {A : Type u} [CommRing A] {I : Ideal A} (γ : DividedPowers I)
  {P : Type u} [CommRing P] [Algebra A P] (J : Ideal P)

/-- The polynomial ring `P[X(n, f) : n ∈ ℕ, f ∈ J]`. -/
abbrev Poly := MvPolynomial (ℕ × J) P

variable (I) in
/-- The ideal of `R/𝔞` generated by the classes of the variables and by `I`. -/
noncomputable def genIdeal (𝔞 : Ideal (Poly J)) : Ideal (Poly J ⧸ 𝔞) :=
  Ideal.span (Set.range fun nf : ℕ × J ↦ Ideal.Quotient.mk 𝔞 (X nf)) ⊔
    I.map (algebraMap A (Poly J ⧸ 𝔞))

/-- An ideal `𝔞 ⊆ R` with divided powers `δ` on `K(𝔞)` is admissible if the classes
of elements of `J` lie in `K(𝔞)`, the class of `X(n, f)` is `δ_{n+1}(f)`, and
`A → R/𝔞` is a divided power morphism. -/
structure IsAdmissible (𝔞 : Ideal (Poly J)) (δ : DividedPowers (genIdeal I J 𝔞)) : Prop where
  mem : ∀ f : J, Ideal.Quotient.mk 𝔞 (C (f : P)) ∈ genIdeal I J 𝔞
  var_eq : ∀ (n : ℕ) (f : J),
    Ideal.Quotient.mk 𝔞 (X (n, f)) = δ.dpow (n + 1) (Ideal.Quotient.mk 𝔞 (C (f : P)))
  compat : γ.IsDPMorphism δ (algebraMap A (Poly J ⧸ 𝔞))

/-- Admissible pairs. -/
def Index : Type u :=
  {s : (𝔞 : Ideal (Poly J)) × DividedPowers (genIdeal I J 𝔞) // IsAdmissible γ J s.1 s.2}

/-- The product `∏_s R/𝔞_s` over all admissible pairs `s`. -/
abbrev Product := ∀ s : Index γ J, Poly J ⧸ s.1.1

/-- The canonical map `R → ∏_s R/𝔞_s`. -/
noncomputable def toProd : Poly J →ₐ[A] Product γ J :=
  AlgHom.pi fun s ↦ Ideal.Quotient.mkₐ A s.1.1

/-- The kernel of `R → ∏_s R/𝔞_s`. -/
noncomputable def envIdeal : Ideal (Poly J) := RingHom.ker (toProd γ J)

/-- The divided power envelope `R/𝔟`. -/
abbrev Env := Poly J ⧸ envIdeal γ J

/-- The structure map `P → Env`. -/
noncomputable def envMap : P →ₐ[A] Env γ J :=
  (Ideal.Quotient.mkₐ A (envIdeal γ J)).comp (IsScalarTower.toAlgHom A P (Poly J))

/-- The embedding `Env → ∏_s R/𝔞_s`. -/
noncomputable def envToProd : Env γ J →ₐ[A] Product γ J :=
  Ideal.Quotient.liftₐ (envIdeal γ J) (toProd γ J) (fun _ ha ↦ ha)

@[simp]
theorem envToProd_mk (p : Poly J) (s : Index γ J) :
    envToProd γ J (Ideal.Quotient.mk (envIdeal γ J) p) s = Ideal.Quotient.mk s.1.1 p :=
  rfl

@[simp]
theorem envToProd_algebraMap (a : A) (s : Index γ J) :
    envToProd γ J (algebraMap A (Env γ J) a) s = algebraMap A (Poly J ⧸ s.1.1) a := by
  rw [AlgHom.commutes]
  rfl

theorem envMap_apply (p : P) :
    envMap γ J p = Ideal.Quotient.mk (envIdeal γ J) (C p) :=
  rfl

@[simp]
theorem envToProd_envMap (p : P) (s : Index γ J) :
    envToProd γ J (envMap γ J p) s = Ideal.Quotient.mk s.1.1 (C p) :=
  rfl

theorem envToProd_injective : Function.Injective (envToProd γ J) := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact Ideal.Quotient.eq_zero_iff_mem.mpr ((RingHom.mem_ker).mpr hx)

variable (I) in
/-- Generators of `K(𝔞)`: the classes of the variables and the image of `I`. -/
def genSet (𝔞 : Ideal (Poly J)) : Set (Poly J ⧸ 𝔞) :=
  Set.range (fun nf : ℕ × J ↦ Ideal.Quotient.mk 𝔞 (X nf)) ∪
    algebraMap A (Poly J ⧸ 𝔞) '' (I : Set A)

theorem genIdeal_eq_span (𝔞 : Ideal (Poly J)) :
    genIdeal I J 𝔞 = Ideal.span (genSet I J 𝔞) := by
  rw [genSet, Ideal.span_union]
  rfl

theorem genSet_subset_genIdeal (𝔞 : Ideal (Poly J)) :
    genSet I J 𝔞 ⊆ genIdeal I J 𝔞 := by
  rw [genIdeal_eq_span]
  exact Ideal.subset_span

theorem mk_X_mem_genIdeal (𝔞 : Ideal (Poly J)) (nf : ℕ × J) :
    Ideal.Quotient.mk 𝔞 (X nf) ∈ genIdeal I J 𝔞 :=
  Ideal.mem_sup_left (Ideal.subset_span ⟨nf, rfl⟩)

theorem algebraMap_mem_genIdeal (𝔞 : Ideal (Poly J)) {a : A} (ha : a ∈ I) :
    algebraMap A (Poly J ⧸ 𝔞) a ∈ genIdeal I J 𝔞 :=
  Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ha)

theorem map_algebraMap_le_genIdeal (𝔞 : Ideal (Poly J)) :
    I.map (algebraMap A (Poly J ⧸ 𝔞)) ≤ genIdeal I J 𝔞 :=
  le_sup_right

/-- The divided power ideal of the envelope. -/
noncomputable abbrev envPDIdeal : Ideal (Env γ J) := genIdeal I J (envIdeal γ J)

/-- The componentwise divided powers of the product. -/
noncomputable abbrev prodDividedPowers :
    DividedPowers (Ideal.pi fun s : Index γ J ↦ genIdeal I J s.1.1) :=
  piDividedPowers fun s : Index γ J ↦ s.1.2

theorem envPDIdeal_map_le :
    (envPDIdeal γ J).map (envToProd γ J).toRingHom ≤
      Ideal.pi fun s : Index γ J ↦ genIdeal I J s.1.1 := by
  refine le_trans (Ideal.map_mono (genIdeal_eq_span J (envIdeal γ J)).le)
    (map_span_le _ _ _ fun g hg ↦ (Ideal.mem_pi _ _).mpr fun s ↦ ?_)
  rcases hg with ⟨nf, rfl⟩ | ⟨a, ha, rfl⟩
  · exact mk_X_mem_genIdeal J s.1.1 nf
  · simpa using algebraMap_mem_genIdeal J s.1.1 ha

theorem envToProd_mem_pi {x : Env γ J} (hx : x ∈ envPDIdeal γ J) :
    envToProd γ J x ∈ Ideal.pi fun s : Index γ J ↦ genIdeal I J s.1.1 :=
  envPDIdeal_map_le γ J (Ideal.mem_map_of_mem _ hx)

/-- The divided powers, computed in the product, of the generators of `K(𝔟)` (the
classes of the variables and the image of `I`) are images of elements of `K(𝔟)`. -/
theorem exists_envToProd_eq_dpow_of_mem_genSet {n : ℕ} (hn : n ≠ 0) {g : Env γ J}
    (hg : g ∈ genSet I J (envIdeal γ J)) :
    ∃ y ∈ Ideal.span (genSet I J (envIdeal γ J)), (envToProd γ J).toRingHom y =
      (prodDividedPowers γ J).dpow n ((envToProd γ J).toRingHom g) := by
  have hmem : (envToProd γ J).toRingHom g ∈ Ideal.pi fun s : Index γ J ↦ genIdeal I J s.1.1 :=
    envToProd_mem_pi γ J (genSet_subset_genIdeal J _ hg)
  rcases hg with ⟨⟨k, f⟩, rfl⟩ | ⟨a, ha, rfl⟩
  · refine ⟨(Nat.uniformBell n (k + 1) : Env γ J) *
        Ideal.Quotient.mk (envIdeal γ J) (X (n * (k + 1) - 1, f)),
      Ideal.mul_mem_left _ _ (Ideal.subset_span (Or.inl ⟨_, rfl⟩)), ?_⟩
    funext s
    rw [piDividedPowers_dpow_apply _ _ hmem]
    simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_mul, map_natCast, Pi.mul_apply,
      Pi.natCast_apply, envToProd_mk]
    rw [s.2.var_eq, s.2.var_eq, s.1.2.dpow_comp (Nat.succ_ne_zero k) (s.2.mem f),
      Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr (mul_ne_zero hn (Nat.succ_ne_zero k)))]
  · refine ⟨algebraMap A (Env γ J) (γ.dpow n a),
      Ideal.subset_span (Or.inr ⟨_, γ.dpow_mem hn ha, rfl⟩), ?_⟩
    funext s
    rw [piDividedPowers_dpow_apply _ _ hmem]
    simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, envToProd_algebraMap]
    exact (s.2.compat.dpow_comp a ha).symm

theorem envPDIdeal_stab : ∀ n ≠ 0, ∀ x ∈ envPDIdeal γ J,
    ∃ y ∈ envPDIdeal γ J, (envToProd γ J).toRingHom y =
      (prodDividedPowers γ J).dpow n ((envToProd γ J).toRingHom x) := by
  intro n hn x hx
  have heq : envPDIdeal γ J = Ideal.span (genSet I J (envIdeal γ J)) := genIdeal_eq_span J _
  obtain ⟨y, hy, e⟩ := exists_dpow_mem_span _ _ _
    (fun g hg ↦ envToProd_mem_pi γ J (genSet_subset_genIdeal J _ hg))
    (fun _ hn _ hg ↦ exists_envToProd_eq_dpow_of_mem_genSet γ J hn hg) n hn x (heq ▸ hx)
  exact ⟨y, heq ▸ hy, e⟩

/-- The divided powers of the envelope, induced from the product. -/
noncomputable def envDividedPowers : DividedPowers (envPDIdeal γ J) :=
  restrictDividedPowers (envToProd γ J).toRingHom (envToProd_injective γ J)
    (prodDividedPowers γ J) (envPDIdeal γ J) (envPDIdeal_map_le γ J) (envPDIdeal_stab γ J)

/-! ## Properties of the envelope -/

theorem envToProd_isDPMorphism :
    (envDividedPowers γ J).IsDPMorphism (prodDividedPowers γ J) (envToProd γ J).toRingHom :=
  isDPMorphism_restrictDividedPowers _ _ _ _ _ _

theorem envToProd_dpow (n : ℕ) {x : Env γ J} (hx : x ∈ envPDIdeal γ J) :
    envToProd γ J ((envDividedPowers γ J).dpow n x) =
      (prodDividedPowers γ J).dpow n (envToProd γ J x) :=
  restrictDividedPowers_apply _ _ _ _ _ _ n hx

theorem envToProd_dpow_apply (n : ℕ) {x : Env γ J} (hx : x ∈ envPDIdeal γ J)
    (s : Index γ J) :
    envToProd γ J ((envDividedPowers γ J).dpow n x) s = s.1.2.dpow n (envToProd γ J x s) := by
  rw [envToProd_dpow γ J n hx, piDividedPowers_dpow_apply _ _ (envToProd_mem_pi γ J hx)]

/-- The projection of the envelope to a factor is a divided power morphism. -/
theorem envToFactor_isDPMorphism (s : Index γ J) :
    (envDividedPowers γ J).IsDPMorphism s.1.2
      ((Pi.evalRingHom _ s).comp (envToProd γ J).toRingHom) :=
  IsDPMorphism.comp s.1.2 (isDPMorphism_piEval _ s) (envToProd_isDPMorphism γ J)

/-- The image of `f ∈ J` in the envelope is the class of `X(0, f)`. -/
theorem envMap_eq_mk_X (f : J) :
    envMap γ J f = Ideal.Quotient.mk (envIdeal γ J) (X (0, f)) := by
  apply envToProd_injective γ J
  funext s
  rw [envToProd_envMap, envToProd_mk, s.2.var_eq, zero_add, s.1.2.dpow_one (s.2.mem f)]

theorem envMap_mem (f : J) : envMap γ J f ∈ envPDIdeal γ J := by
  rw [envMap_eq_mk_X]
  exact mk_X_mem_genIdeal J _ _

theorem envMap_le :
    J.map (envMap γ J).toRingHom ⊔ I.map (algebraMap A (Env γ J)) ≤ envPDIdeal γ J := by
  refine sup_le (Ideal.map_le_iff_le_comap.mpr fun f hf ↦ ?_) (map_algebraMap_le_genIdeal J _)
  exact envMap_mem γ J ⟨f, hf⟩

theorem env_compat : γ.IsDPMorphism (envDividedPowers γ J) (algebraMap A (Env γ J)) := by
  refine ⟨map_algebraMap_le_genIdeal J _, fun a ha ↦ ?_⟩
  apply envToProd_injective γ J
  funext s
  rw [envToProd_dpow_apply γ J _ (algebraMap_mem_genIdeal J _ ha), envToProd_algebraMap,
    envToProd_algebraMap]
  exact s.2.compat.dpow_comp a ha

/-- The class of `X(n, f)` in the envelope is `δ_{n+1}(f)`. -/
theorem env_var_eq (n : ℕ) (f : J) :
    Ideal.Quotient.mk (envIdeal γ J) (X (n, f)) =
      (envDividedPowers γ J).dpow (n + 1) (envMap γ J f) := by
  apply envToProd_injective γ J
  funext s
  rw [envToProd_dpow_apply γ J _ (envMap_mem γ J f), envToProd_envMap, envToProd_mk]
  exact s.2.var_eq n f

end Construction

/-! ## The universal property -/

section Universal

variable {A : Type u} [CommRing A] {I : Ideal A} (γ : DividedPowers I)
  {P : Type u} [CommRing P] [Algebra A P] (J : Ideal P)
  {D' : Type v} [CommRing D'] [Algebra A D'] {K' : Ideal D'} (φ' : P →ₐ[A] D')
  (δ' : DividedPowers K')

/-- The evaluation `R → D'`, `X(n, f) ↦ δ'_{n+1}(φ' f)`. -/
noncomputable def evalHom : Poly J →+* D' :=
  eval₂Hom φ'.toRingHom fun nf ↦ δ'.dpow (nf.1 + 1) (φ' nf.2)

@[simp]
theorem evalHom_C (p : P) : evalHom J φ' δ' (C p) = φ' p := by
  simp [evalHom]

@[simp]
theorem evalHom_X (n : ℕ) (f : J) :
    evalHom J φ' δ' (X (n, f)) = δ'.dpow (n + 1) (φ' f) := by
  simp [evalHom]

@[simp]
theorem evalHom_algebraMap (a : A) :
    evalHom J φ' δ' (algebraMap A (Poly J) a) = algebraMap A D' a := by
  rw [MvPolynomial.algebraMap_apply, evalHom_C, AlgHom.commutes]

/-- The kernel of the evaluation. -/
noncomputable abbrev smallIdeal : Ideal (Poly J) := RingHom.ker (evalHom J φ' δ')

/-- The embedding `R/𝔞 → D'`. -/
noncomputable def smallToTarget : Poly J ⧸ smallIdeal J φ' δ' →+* D' :=
  RingHom.kerLift (evalHom J φ' δ')

@[simp]
theorem smallToTarget_mk (x : Poly J) :
    smallToTarget J φ' δ' (Ideal.Quotient.mk _ x) = evalHom J φ' δ' x :=
  RingHom.kerLift_mk _ x

theorem smallToTarget_injective : Function.Injective (smallToTarget J φ' δ') :=
  RingHom.kerLift_injective _

@[simp]
theorem smallToTarget_algebraMap (a : A) :
    smallToTarget J φ' δ' (algebraMap A (Poly J ⧸ smallIdeal J φ' δ') a) = algebraMap A D' a := by
  rw [← Ideal.Quotient.mk_algebraMap, smallToTarget_mk, evalHom_algebraMap]

variable (hle : J.map φ'.toRingHom ⊔ I.map (algebraMap A D') ≤ K')
  (hc : γ.IsDPMorphism δ' (algebraMap A D'))

include hle in
theorem phi_mem (f : J) : φ' (f : P) ∈ K' :=
  hle (Ideal.mem_sup_left (Ideal.mem_map_of_mem φ'.toRingHom f.2))

include hle in
/-- The generators of `K(𝔞)` are mapped into `K'`. -/
theorem small_gen_mem : ∀ g ∈ Set.range (fun nf : ℕ × J ↦
      Ideal.Quotient.mk (smallIdeal J φ' δ') (X nf)) ∪
      algebraMap A (Poly J ⧸ smallIdeal J φ' δ') '' (I : Set A),
    smallToTarget J φ' δ' g ∈ K' := by
  rintro g (⟨⟨n, f⟩, rfl⟩ | ⟨a, ha, rfl⟩)
  · rw [smallToTarget_mk, evalHom_X]
    exact δ'.dpow_mem (Nat.succ_ne_zero n) (phi_mem J φ' hle f)
  · rw [smallToTarget_algebraMap]
    exact hle (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ha))

-- `hc` is not needed here; it is kept so that `small_map_le` has the same arguments as
-- `small_stab` and `smallDividedPowers`.
set_option linter.unusedSectionVars false in
include hle hc in
theorem small_map_le :
    (genIdeal I J (smallIdeal J φ' δ')).map (smallToTarget J φ' δ') ≤ K' := by
  rw [genIdeal_eq_span (I := I) J]
  exact map_span_le _ _ _ (small_gen_mem J φ' δ' hle)

include hle hc in
theorem small_stab : ∀ n ≠ 0, ∀ x ∈ genIdeal I J (smallIdeal J φ' δ'),
    ∃ y ∈ genIdeal I J (smallIdeal J φ' δ'),
      smallToTarget J φ' δ' y = δ'.dpow n (smallToTarget J φ' δ' x) := by
  rw [genIdeal_eq_span (I := I) J]
  refine exists_dpow_mem_span _ δ' _ (small_gen_mem J φ' δ' hle) ?_
  rintro m hm g (⟨⟨n, f⟩, rfl⟩ | ⟨a, ha, rfl⟩)
  · refine ⟨(Nat.uniformBell m (n + 1) : Poly J ⧸ smallIdeal J φ' δ') *
      Ideal.Quotient.mk _ (X (m * (n + 1) - 1, f)), ?_, ?_⟩
    · exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Or.inl ⟨_, rfl⟩))
    · have hpos : m * (n + 1) - 1 + 1 = m * (n + 1) :=
        Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero hm n.succ_ne_zero))
      rw [map_mul, map_natCast, smallToTarget_mk, smallToTarget_mk, evalHom_X, evalHom_X, hpos,
        δ'.dpow_comp n.succ_ne_zero (phi_mem J φ' hle f)]
  · refine ⟨algebraMap A _ (γ.dpow m a), Ideal.subset_span (Or.inr ⟨_, γ.dpow_mem hm ha, rfl⟩), ?_⟩
    rw [smallToTarget_algebraMap, smallToTarget_algebraMap, hc.dpow_comp a ha]

/-- The divided powers on `K(𝔞) ⊆ R/𝔞` induced from `D'`. -/
noncomputable def smallDividedPowers : DividedPowers (genIdeal I J (smallIdeal J φ' δ')) :=
  restrictDividedPowers (smallToTarget J φ' δ') (RingHom.kerLift_injective _) δ'
    (genIdeal I J (smallIdeal J φ' δ')) (small_map_le γ J φ' δ' hle hc)
    (small_stab γ J φ' δ' hle hc)

theorem smallDividedPowers_apply (n : ℕ) {x : Poly J ⧸ smallIdeal J φ' δ'}
    (hx : x ∈ genIdeal I J (smallIdeal J φ' δ')) :
    smallToTarget J φ' δ' ((smallDividedPowers γ J φ' δ' hle hc).dpow n x) =
      δ'.dpow n (smallToTarget J φ' δ' x) :=
  restrictDividedPowers_apply _ _ _ _ _ _ n hx

theorem small_isAdmissible :
    IsAdmissible γ J (smallIdeal J φ' δ') (smallDividedPowers γ J φ' δ' hle hc) := by
  have hmem : ∀ f : J, Ideal.Quotient.mk (smallIdeal J φ' δ') (C (f : P)) ∈
      genIdeal I J (smallIdeal J φ' δ') := by
    intro f
    have heq : Ideal.Quotient.mk (smallIdeal J φ' δ') (C (f : P)) =
        Ideal.Quotient.mk (smallIdeal J φ' δ') (X (0, f)) := by
      apply smallToTarget_injective
      rw [smallToTarget_mk, smallToTarget_mk, evalHom_C, evalHom_X, zero_add,
        δ'.dpow_one (phi_mem J φ' hle f)]
    rw [heq]
    exact Ideal.mem_sup_left (Ideal.subset_span ⟨_, rfl⟩)
  refine ⟨hmem, fun n f ↦ ?_, ?_⟩
  · apply smallToTarget_injective
    rw [smallDividedPowers_apply _ _ _ _ _ _ _ (hmem f), smallToTarget_mk, smallToTarget_mk,
      evalHom_X, evalHom_C]
  · refine ⟨le_sup_right, fun {n} a ha ↦ ?_⟩
    apply smallToTarget_injective
    rw [smallDividedPowers_apply _ _ _ _ _ _ _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ha)),
      smallToTarget_algebraMap, smallToTarget_algebraMap, hc.dpow_comp a ha]

/-- The admissible pair defined by `D'`. -/
noncomputable def smallIndex : Index γ J :=
  ⟨⟨smallIdeal J φ' δ', smallDividedPowers γ J φ' δ' hle hc⟩, small_isAdmissible γ J φ' δ' hle hc⟩

/-- The map `Env → D'`. -/
noncomputable def lift : Env γ J →ₐ[A] D' :=
  { toRingHom := (smallToTarget J φ' δ').comp
      ((Pi.evalRingHom (fun s : Index γ J ↦ Poly J ⧸ s.1.1) (smallIndex γ J φ' δ' hle hc)).comp
        (envToProd γ J).toRingHom)
    commutes' := fun a ↦ by
      change smallToTarget J φ' δ'
        ((envToProd γ J) (algebraMap A (Env γ J) a) (smallIndex γ J φ' δ' hle hc)) = _
      rw [AlgHom.commutes]
      exact smallToTarget_algebraMap J φ' δ' a }

theorem lift_mk (x : Poly J) :
    lift γ J φ' δ' hle hc (Ideal.Quotient.mk _ x) = evalHom J φ' δ' x :=
  smallToTarget_mk J φ' δ' x

theorem lift_comp : (lift γ J φ' δ' hle hc).comp (envMap γ J) = φ' := by
  ext p
  change lift γ J φ' δ' hle hc (Ideal.Quotient.mk _ (C p)) = φ' p
  rw [lift_mk, evalHom_C]

theorem lift_isDPMorphism :
    (envDividedPowers γ J).IsDPMorphism δ' (lift γ J φ' δ' hle hc).toRingHom :=
  IsDPMorphism.comp (hJ := smallDividedPowers γ J φ' δ' hle hc) δ'
    (isDPMorphism_restrictDividedPowers _ _ _ _ _ _)
    (envToFactor_isDPMorphism γ J (smallIndex γ J φ' δ' hle hc))

omit hle hc in
/-- Uniqueness: a divided power `A`-algebra map `Env → D'` is determined by its
composite with `envMap`. -/
theorem hom_ext {ψ₁ ψ₂ : Env γ J →ₐ[A] D'}
    (h : ψ₁.comp (envMap γ J) = ψ₂.comp (envMap γ J))
    (h₁ : (envDividedPowers γ J).IsDPMorphism δ' ψ₁.toRingHom)
    (h₂ : (envDividedPowers γ J).IsDPMorphism δ' ψ₂.toRingHom) : ψ₁ = ψ₂ := by
  have hP : ∀ p : P, ψ₁ (envMap γ J p) = ψ₂ (envMap γ J p) := fun p ↦
    DFunLike.congr_fun h p
  suffices hr : ψ₁.toRingHom = ψ₂.toRingHom by
    ext x
    exact DFunLike.congr_fun hr x
  refine Ideal.Quotient.ringHom_ext (MvPolynomial.ringHom_ext (fun p ↦ hP p) ?_)
  rintro ⟨n, f⟩
  have hf : envMap γ J (f : P) ∈ envPDIdeal γ J :=
    envMap_le γ J (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ f.2))
  change ψ₁ (Ideal.Quotient.mk _ (X (n, f))) = ψ₂ (Ideal.Quotient.mk _ (X (n, f)))
  rw [env_var_eq]
  change ψ₁.toRingHom _ = ψ₂.toRingHom _
  rw [← h₁.dpow_comp _ hf, ← h₂.dpow_comp _ hf]
  change δ'.dpow (n + 1) (ψ₁ (envMap γ J f)) = δ'.dpow (n + 1) (ψ₂ (envMap γ J f))
  rw [hP]

include hle hc in
/-- **Universal property of the envelope.** -/
theorem existsUnique_lift :
    ∃! ψ : Env γ J →ₐ[A] D',
      ψ.comp (envMap γ J) = φ' ∧ (envDividedPowers γ J).IsDPMorphism δ' ψ.toRingHom :=
  ⟨lift γ J φ' δ' hle hc, ⟨lift_comp γ J φ' δ' hle hc, lift_isDPMorphism γ J φ' δ' hle hc⟩,
    fun _ hψ ↦ hom_ext γ J δ' ((hψ.1.trans (lift_comp γ J φ' δ' hle hc).symm)) hψ.2
      (lift_isDPMorphism γ J φ' δ' hle hc)⟩

end Universal

/-! ## The envelope satisfies `IsDPEnvelope` -/

section Choice

variable {A : Type u} [CommRing A] {I : Ideal A} (γ : DividedPowers I)
  {P : Type u} [CommRing P] [Algebra A P] (J : Ideal P)

/-- The envelope `Env γ J` is a divided power envelope of `J` relative to
`(A, I, γ)`. -/
theorem env_isDPEnvelope :
    IsDPEnvelope γ J (Env γ J) (envMap γ J) (envPDIdeal γ J) (envDividedPowers γ J) where
  le := envMap_le γ J
  compat := env_compat γ J
  isInitial _ φ' δ' hle hc := existsUnique_lift γ J φ' δ' hle hc

/-- The envelope `Env γ J` as a `DPEnvelopeChoice`. -/
noncomputable def dpEnvelopeChoice : DPEnvelopeChoice γ J where
  carrier := Env γ J
  commRing := inferInstance
  algebra := inferInstance
  map := envMap γ J
  pdIdeal := envPDIdeal γ J
  dividedPowers := envDividedPowers γ J
  isEnvelope := env_isDPEnvelope γ J

/-- **Existence of divided power envelopes.** Every ideal `J` of an `A`-algebra
has a divided power envelope relative to `(A, I, γ)`. -/
instance hasDPEnvelope : HasDPEnvelope γ J :=
  ⟨⟨dpEnvelopeChoice γ J⟩⟩

end Choice

end AffineCrystalline.DPEnvelope
